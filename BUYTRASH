			listFrame

		container.Size =
			UDim2.new(1,-5,0,45)

		container.BackgroundColor3 =
			Color3.fromRGB(40,40,40)

		container.BorderSizePixel =
			0


		Instance.new("UICorner",container)


		local nameBtn =
			Instance.new("TextButton")

		nameBtn.Parent =
			container

		nameBtn.Size =
			UDim2.new(0.58,0,1,0)

		nameBtn.Position =
			UDim2.new(0.03,0,0,0)

		nameBtn.BackgroundTransparency =
			1

		nameBtn.TextXAlignment =
			Enum.TextXAlignment.Left

		nameBtn.Font =
			Enum.Font.GothamBold

		nameBtn.TextSize =
			13


		local minWeight =
			tonumber(data.minWeight)
			or tonumber(data.BaseWeight)
			or 0


		local minLevel =
			tonumber(data.minLevel)
			or tonumber(data.Level)
			or 0


		nameBtn.Text =
			tostring(data.pet)
			.." | KG:"
			..tostring(minWeight)
			.." | LVL:"
			..tostring(minLevel)
			.." | M:"
			..(
				data.mutation
				and data.mutation ~= ""
				and data.mutation
				or "Any"
			)
			.." | $"
			..tostring(data.price)


		nameBtn.AutoButtonColor =
			false


		if selectedFindSellerPet ==
			data.pet then

			nameBtn.TextColor3 =
				Color3.fromRGB(
					0,
					255,
					100
				)

		else

			nameBtn.TextColor3 =
				Color3.new(1,1,1)

		end


		nameBtn.Activated:Connect(function()

			selectedFindSellerPet =
				data.pet

			saveFindSellerTarget(
				data.pet
			)

			info.Text =
				"FindSeller : "
				..data.pet

			refreshPetList()

		end)


		local pBox =
			Instance.new("TextBox")

		pBox.Parent =
			container

		pBox.Size =
			UDim2.new(0.22,0,0.75,0)

