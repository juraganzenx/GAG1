--//========================================================
--// PET DATA
--//========================================================

local function getPetData(item)

    if type(item) ~= "table" then
        return {}
    end

    return item.PetData or {}

end

local function getBaseWeight(item)

    local petData = getPetData(item)

    return tonumber(
        petData.BaseWeight
        or petData.baseWeight
    ) or 0

end

local function getLevel(item)

    local petData = getPetData(item)

    return tonumber(
        petData.Level
        or petData.level
    ) or 0

end

local function getMutationType(item)

    local petData = getPetData(item)

    return tostring(
        petData.MutationType
        or petData.mutationType
        or petData.Mutation
        or ""
    )

end

