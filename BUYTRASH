local function refreshSearch()

	clearResults()

	local text = searchBox.Text:lower()

	if text == "" then
		return
	end

	------------------------------------------------
	-- EGG GROUP
	------------------------------------------------
	for eggName,_ in pairs(EggGroups) do

		if string.find(eggName:lower(),text) then

			local btn = Instance.new("TextButton")
			btn.Parent = resultFrame
			btn.Size = UDim2.new(1,-5,0,30)
			btn.Text = "[EGG] "..eggName
			btn.Font = Enum.Font.GothamBold
			btn.TextSize = 14
			btn.BackgroundColor3 = Color3.fromRGB(80,60,20)
			btn.TextColor3 = Color3.fromRGB(255,220,100)
			btn.BorderSizePixel = 0
			Instance.new("UICorner",btn)

			btn.Activated:Connect(function()

				selectedPet = eggName
				searchBox.Text = eggName

				clearResults()

			end)

		end

	end

	------------------------------------------------
	-- PET LIST
	------------------------------------------------
	local count = 0

	for petName,_ in pairs(PetList) do

		if string.find(petName:lower(),text) then

			count += 1

			if count > 70 then
				break
			end

			local btn = Instance.new("TextButton")
			btn.Parent = resultFrame
			btn.Size = UDim2.new(1,-5,0,30)
			btn.Text = petName
			btn.Font = Enum.Font.Gotham
			btn.TextSize = 14
			btn.BackgroundColor3 = Color3.fromRGB(45,45,45)
			btn.TextColor3 = Color3.new(1,1,1)
			btn.BorderSizePixel = 0
			Instance.new("UICorner",btn)

			btn.Activated:Connect(function()

				selectedPet = petName
				searchBox.Text = petName

				clearResults()

			end)

		end

	end

	updateCanvas()

end

