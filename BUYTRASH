--========================================================
-- BUY STATE
--========================================================

local buying =
	false

local matchedListings =
	{}


--========================================================
-- SCAN LISTINGS
--========================================================

local function scanListings()

	table.clear(
		matchedListings
	)


	local ok, data =
		pcall(function()

			return BoothsReplication:GetDataAsync()

		end)


	if not ok
	or not data then

		info.Text =
			"Booths data unavailable"

		return 0

	end


	--------------------------------------------------------
	-- LOOP BOOTHS
	--------------------------------------------------------

	for _,booth in pairs(
		data.Booths or {}
	) do

		local ownerId =
			booth.Owner


		local pData =
			ownerId
			and data.Players
			and data.Players[ownerId]


		if pData then

			for uuid,listing in pairs(
				pData.Listings or {}
			) do

				local item =
					pData.Items
					and pData.Items[
						listing.ItemId
					]


				if item then

					------------------------------------------------
					-- ITEM NAME
					------------------------------------------------

					local rawName =
						item.Name
						or item.PetType
						or ""


					local successName,
						nameResult =
						pcall(function()

							return ItemNameFinder(
								rawName,
								listing.ItemType
							)

						end)


					local name


					if successName
					and nameResult then

						name =
							tostring(
								nameResult
							):lower()

					else

						name =
							tostring(
								rawName
							):lower()

					end


					------------------------------------------------
					-- ITEM STATS
					------------------------------------------------

					local itemWeight =
						getBaseWeight(
							item
						)


					local itemLevel =
						getLevel(
							item
						)


					local itemMutation =
						getMutationType(
							item
						)


					------------------------------------------------
					-- CHECK ALL TARGETS
					------------------------------------------------

					for _,wanted in ipairs(
						petDataList
					) do

						local matched =
							false


						------------------------------------------------
						-- NORMAL PET
						------------------------------------------------

						if name ==
							tostring(
								wanted.pet
								or ""
							):lower() then

							matched =
								true

						end


						------------------------------------------------
						-- EGG GROUP
						------------------------------------------------

						if EggGroups[
							wanted.pet
						] then

							for _,eggPet in ipairs(
								EggGroups[
									wanted.pet
								]
							) do

								if name ==
									eggPet:lower() then

									matched =
										true

									break

								end

							end

						end


						if matched then

							------------------------------------------------
							-- TARGET REQUIREMENTS
							------------------------------------------------

							local minWeight =
								tonumber(
									wanted.minWeight
								)
								or tonumber(
									wanted.BaseWeight
								)
								or 0


							local minLevel =
								tonumber(
									wanted.minLevel
								)
								or tonumber(
									wanted.Level
								)
								or 0


							local maxPrice =
								tonumber(
									wanted.price
								)


							------------------------------------------------
							-- MUTATION
							------------------------------------------------

							local wantedMutation =
								tostring(
									wanted.mutation
									or ""
								):lower()


							local mutationMatched =
								wantedMutation == ""
								or wantedMutation == "any"
								or itemMutation:lower()
									== wantedMutation


							------------------------------------------------
							-- PRICE
							------------------------------------------------

							local priceMatched =
								maxPrice
								and tonumber(
									listing.Price
								)
								and tonumber(
									listing.Price
								)
								<= maxPrice


							------------------------------------------------
							-- FINAL MATCH
							------------------------------------------------

							if priceMatched
							and itemWeight >= minWeight
							and itemLevel >= minLevel
							and mutationMatched then

								local owner


								pcall(function()

									owner =
										TradeBoothsData.getPlayerById(
											ownerId
										)

								end)


								if owner then

									table.insert(
										matchedListings,
										{

											owner =
												owner,

											uuid =
												uuid,

											name =
												name,

											price =
												listing.Price,

											weight =
												itemWeight,

											level =
												itemLevel,

											mutation =
												itemMutation,

											target =
												wanted.pet

										}
									)


									info.Text =
										("FOUND %s | $%s | L:%s | KG:%s | M:%s")
										:format(

											name,

											tostring(
												listing.Price
											),

											tostring(
												itemLevel
											),

											tostring(
												itemWeight
											),

											tostring(
												itemMutation
											)

										)

								end


								break

							end

						end

					end

				end

			end

		end

	end


	info.Text =
		"Found "
		..#matchedListings


	return #matchedListings

end


--========================================================
-- BUY ALL MATCH
--========================================================

local function buyAllMatch()

	--------------------------------------------------------
	-- HARD LOCK
	--------------------------------------------------------

	if buying then

		info.Text =
			"BUY ALREADY RUNNING"

		return

	end


	if teleportingSeller then

		info.Text =
			"FIND SELLER RUNNING"

		return

	end


	--------------------------------------------------------
	-- SCAN
	--------------------------------------------------------

	local count =
		scanListings()


	--------------------------------------------------------
	-- NO MATCH
	--------------------------------------------------------

	if count <= 0 then

		info.Text =
			"No Listing"


		----------------------------------------------------
		-- IMPORTANT:
		-- WAIT BEFORE FIND SELLER
		----------------------------------------------------

		task.wait(1)


		if buying
		or teleportingSeller then
			return
		end


		if selectedFindSellerPet
		and selectedFindSellerPet ~= "" then

			teleportToSeller(
				selectedFindSellerPet
			)

		end


		return

	end


	--------------------------------------------------------
	-- START BUY
	--------------------------------------------------------

	buying =
		true


	for i,v in ipairs(
		matchedListings
	) do

		if not buying then
			break
		end


		if teleportingSeller then

			warn(
				"FindSeller blocked while BUY"
			)

			break

		end


		info.Text =
			("BUYING %d/%d | %s")
			:format(

				i,

				#matchedListings,

				tostring(
					v.target
				)

			)


		local buyOK, buyResult =
			pcall(function()

				return TradeEvents
					.Booths
					.BuyListing
					:InvokeServer(

						v.owner,

						v.uuid

					)

			end)


		if buyOK then

			print(
				"[BUY SUCCESS]",
				v.target,
				v.price
			)

		else

			warn(
				"[BUY ERROR]",
				buyResult
			)

		end


		----------------------------------------------------
		-- WAIT BETWEEN BUYS
		----------------------------------------------------

		task.wait(2)

	end


	--------------------------------------------------------
	-- FINISH BUY
	--------------------------------------------------------

	buying =
		false


	info.Text =
		"Finished Buying"


	--------------------------------------------------------
	-- IMPORTANT
	-- DO NOT FIND SELLER IMMEDIATELY
	--
	-- RESCAN FIRST
	--------------------------------------------------------

	task.wait(2)


	local remaining =
		scanListings()


	if remaining > 0 then

		info.Text =
			"More listings found"

		return

	end


	--------------------------------------------------------
	-- ONLY NOW FIND SELLER
	--------------------------------------------------------

	if selectedFindSellerPet
	and selectedFindSellerPet ~= ""
	and not teleportingSeller
	and not buying then

		task.wait(2)


		if not teleportingSeller
		and not buying then

			teleportToSeller(
				selectedFindSellerPet
			)

		end

	end

end


