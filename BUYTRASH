local function refreshPetList()

	for _, v in ipairs(
		listFrame:GetChildren()
	) do

		if v:IsA("Frame") then
			v:Destroy()
		end

	end


	for i, data in ipairs(petDataList) do

		local container =
			Instance.new("Frame")

		container.Parent =
			listFrame

		container.Size =
			UDim2.new(1,-5,0,45)

		container.BackgroundColor3 =
			Color3.fromRGB(40,40,40)

		container.BorderSizePixel = 0

		Instance.new("UICorner", container)


		--// NAME

		local nameBtn =
			Instance.new("TextButton")

		nameBtn.Parent =
			container

		nameBtn.Size =
			UDim2.new(0.62,0,1,0)

		nameBtn.Position =
			UDim2.new(0.03,0,0,0)

		nameBtn.BackgroundTransparency = 1

		nameBtn.TextXAlignment =
			Enum.TextXAlignment.Left

		nameBtn.Font =
			Enum.Font.GothamBold

		nameBtn.TextSize = 12


		nameBtn.Text =
			tostring(data.pet)
			.." | KG:"
			..tostring(
				data.minWeight or 0
			)
			.." | LVL:"
			..tostring(
				data.minLevel or 0
			)
			.." | M:"
			..(
				data.mutation ~= nil
				and data.mutation ~= ""
				and data.mutation
				or "Any"
			)
			.." | $"
			..tostring(data.price)


		nameBtn.AutoButtonColor = false


		if selectedFindSellerPet ==
			data.pet then

			nameBtn.TextColor3 =
				Color3.fromRGB(
					0,255,100
				)

		else

			nameBtn.TextColor3 =
				Color3.new(1,1,1)

		end


		nameBtn.Activated:Connect(function()

			selectedFindSellerPet =
				data.pet

			saveFindSellerTarget(
				data.pet
			)

			info.Text =
				"FindSeller : "
				..data.pet

			refreshPetList()

		end)


		--// PRICE EDIT

		local pBox =
			Instance.new("TextBox")

		pBox.Parent =
			container

		pBox.Size =
			UDim2.new(0.18,0,0.75,0)

		pBox.Position =
			UDim2.new(0.65,0,0.125,0)

		pBox.Text =
			tostring(data.price)

		pBox.Font =
			Enum.Font.GothamBold

		pBox.TextSize = 12

		pBox.BackgroundColor3 =
			Color3.fromRGB(55,55,55)

		pBox.TextColor3 =
			Color3.fromRGB(
				0,255,100
			)

		pBox.BorderSizePixel = 0

		Instance.new("UICorner", pBox)


		pBox.FocusLost:Connect(function()

			local num =
				tonumber(pBox.Text)

			if not num then

				pBox.Text =
					tostring(data.price)

				return

			end

			data.price = num

			saveSettings(
				petDataList
			)

		end)


		--// REMOVE

		local removeBtn =
			Instance.new("TextButton")

		removeBtn.Parent =
			container

		removeBtn.Size =
			UDim2.new(0,28,0,28)

		removeBtn.Position =
			UDim2.new(1,-35,0.5,-14)

		removeBtn.Text = "-"

		removeBtn.Font =
			Enum.Font.GothamBold

		removeBtn.TextSize = 18

		removeBtn.BackgroundColor3 =
