--========================================================
-- SAVE FILES
--========================================================

local SAVE_FILE =
	"AutoBUYLISTINGHUGE.txt"


local AUTO_BUY_FILE =
	"AutoBuyStatusHUGE.txt"


local FIND_SELLER_FILE =
	"FindSellerTargetHUGE.txt"


--========================================================
-- SAVE SETTINGS
--========================================================

local function saveSettings(data)

	if not writefile then
		return
	end

	pcall(function()

		writefile(
			SAVE_FILE,
			HttpService:JSONEncode(data)
		)

	end)

end


local function loadSettings()

	if not readfile
	or not isfile
	or not isfile(SAVE_FILE) then

		return {}

	end


	local ok, data = pcall(function()

		return HttpService:JSONDecode(
			readfile(SAVE_FILE)
		)

	end)


	if ok and type(data) == "table" then
		return data
	end


	return {}

end


--========================================================
-- AUTO BUY SAVE
--========================================================

local function saveAutoBuyStatus(state)

	if not writefile then
		return
	end

	pcall(function()

		writefile(
			AUTO_BUY_FILE,
			state and "ON" or "OFF"
		)

	end)

end


local function loadAutoBuyStatus()

	if not isfile
	or not readfile
	or not isfile(AUTO_BUY_FILE) then

		return false

	end


	local ok, data =
		pcall(
			readfile,
			AUTO_BUY_FILE
		)


	if ok and data then
		return data == "ON"
	end


	return false

end


--========================================================
-- FIND SELLER SAVE
--========================================================

local function saveFindSellerTarget(target)

	if not writefile then
		return
	end

	pcall(function()

		writefile(
			FIND_SELLER_FILE,
			target or ""
		)

	end)

end


local function loadFindSellerTarget()

	if not readfile
	or not isfile
	or not isfile(FIND_SELLER_FILE) then

		return nil

	end


	local ok, data =
		pcall(
			readfile,
			FIND_SELLER_FILE
		)


	if ok and data ~= "" then
		return data
	end


	return nil

end


--========================================================
-- FIND SELLER PET
--========================================================

local function getFindSellerPet(target)

	if EggGroups[target] then
		return EggGroups[target][1]
	end

	return target

end


