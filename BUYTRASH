----------------------------------------------------------------
-- TELEPORT TO SELLER
----------------------------------------------------------------
local teleportingSeller = false

local function teleportToSeller(selectedPet)

	if teleportingSeller then
		return
	end

	teleportingSeller = true

	---------------------------------------------------
	-- EGG -> FIRST PET
	---------------------------------------------------

	selectedPet = getFindSellerPet(selectedPet)

	if not selectedPet or selectedPet == "" then
		teleportingSeller = false
		return
	end

	info.Text = "Finding seller for "..selectedPet

	task.wait(3)

	local playerGui = LocalPlayer:WaitForChild("PlayerGui")

	---------------------------------------------------
	-- SAFE CLICK
	---------------------------------------------------

	local function safeClick(pathTable)

		local obj

		local ok = pcall(function()

			obj = playerGui

			for _,v in ipairs(pathTable) do
				obj = obj:WaitForChild(v,5)
			end

		end)

		if ok and obj then

			uiClick(obj)

			return true
		end

		return false

	end

	---------------------------------------------------
	-- OPEN INDEX
	---------------------------------------------------

	safeClick({
		"Teleport_UI",
		"TradePlaza",
		"Index"
	})

	task.wait(1)

	---------------------------------------------------
	-- CLICK PETS
	---------------------------------------------------

	safeClick({
		"TradePlazaIndex",
		"Frame",
		"SideBtns",
		"Pets"
	})

	task.wait(1)

	---------------------------------------------------
	-- SEARCH BOX
	---------------------------------------------------

	local searchBox

	pcall(function()

		searchBox = playerGui
			:WaitForChild("TradePlazaIndex")
			:WaitForChild("Frame")
			:WaitForChild("Sections")
			:WaitForChild("ItemsList")
			:WaitForChild("SearchBox")

	end)

	if not searchBox then

		info.Text = "SearchBox not found"
		teleportingSeller = false

		return
	end

	---------------------------------------------------
	-- TYPE SEARCH
	---------------------------------------------------

	pcall(function()

		searchBox:CaptureFocus()

		task.wait(0.2)

		searchBox.Text = ""

		task.wait(0.1)

		searchBox.Text = selectedPet

	end)

	task.wait(0.5)

	---------------------------------------------------
	-- PRESS ENTER
	---------------------------------------------------

	pcall(function()

		VirtualInputManager:SendKeyEvent(
			true,
			Enum.KeyCode.Return,
			false,
			game
		)

		task.wait(0.05)

		VirtualInputManager:SendKeyEvent(
			false,
			Enum.KeyCode.Return,
			false,
			game
		)

	end)

	task.wait(1)

	---------------------------------------------------
	-- FIND PET BUTTON
	---------------------------------------------------

	local petBtn

	for i = 1, 80 do

		pcall(function()

			local virtualList = playerGui
				:WaitForChild("TradePlazaIndex")
				:WaitForChild("Frame")
				:WaitForChild("Sections")
				:WaitForChild("ItemsList")
				:WaitForChild("ItemsVirtualList")

			------------------------------------------------
			-- EXACT
			------------------------------------------------

			petBtn = virtualList:FindFirstChild(selectedPet)

			------------------------------------------------
			-- LOWER SEARCH
			------------------------------------------------

			if not petBtn then

				for _,v in ipairs(virtualList:GetChildren()) do

					if v.Name:lower():find(selectedPet:lower()) then
						petBtn = v
						break
					end

				end

			end

		end)

		if petBtn then
			break
		end

		task.wait(0.1)

	end

	if not petBtn then

		info.Text = selectedPet.." not found"

		teleportingSeller = false

		return
	end

	---------------------------------------------------
	-- CLICK PET
	---------------------------------------------------

	uiClick(petBtn)

	task.wait(1)

	---------------------------------------------------
	-- FIND SELLER BUTTON
	---------------------------------------------------

	local findBtn

	pcall(function()

		findBtn = playerGui
			:WaitForChild("TradePlazaIndex")
			:WaitForChild("Frame")
			:WaitForChild("Sections")
			:WaitForChild("RAPHistory")
			:WaitForChild("FindSellers")

	end)

	if not findBtn then

		info.Text = "FindSeller button missing"

		teleportingSeller = false

