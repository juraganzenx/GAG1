--//========================================================

addBtn.Activated:Connect(function()

    local pet =
        selectedPet
        or searchBox.Text

    if not pet
    or pet == "" then

        info.Text =
            "Input Pet"

        return

    end

    local price =
        tonumber(priceBox.Text)

    if not price then

        info.Text =
            "Input Price"

        return

    end

    local minWeight =
        tonumber(minWeightBox.Text)
        or 0

    local minLevel =
        tonumber(minLevelBox.Text)
        or 0

    local mutation =
        tostring(mutationBox.Text or "")

    table.insert(
        petDataList,
        {

            pet = pet,

            price = price,

            mutation = mutation,

            minWeight = minWeight,

            minLevel = minLevel

        }
    )

    saveSettings(
        petDataList
    )

    refreshPetList()

    searchBox.Text = ""

    priceBox.Text = ""

    minWeightBox.Text = ""

    minLevelBox.Text = ""

    mutationBox.Text = ""

    selectedPet = nil

    info.Text =
        "Added "
        ..tostring(pet)

end)

