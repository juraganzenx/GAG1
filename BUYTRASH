local teleportingSeller = false


local function clearFindSellerState()

	getgenv().FindSellerListingId = nil
	getgenv().FindSellerPet = nil

end


--//========================================================
--// DIRECT FIND SELLER
--//========================================================
--//
--// IMPORTANT:
--// NO GUI CLICK
--//
--// FindSellers:InvokeServer()
--// TeleportToListing:InvokeServer()
--//
--//========================================================

local function teleportToSeller(
	selectedPet
)

	if teleportingSeller then
		return false
	end


	teleportingSeller = true


	selectedPet =
		getFindSellerPet(
			selectedPet
		)


	if not selectedPet
	or selectedPet == "" then

		teleportingSeller = false

		return false

	end


	info.Text =
		"Finding seller: "
		..selectedPet


	--// GET ITEM DATA

	local dataOK, itemData =
		pcall(function()

			return RAPUtil.GetDefaultItemData(
				"Pet",
				selectedPet
			)

		end)


	if not dataOK
	or not itemData then

		warn(
			"GetDefaultItemData failed:",
			itemData
		)

		info.Text =
			"Item data error"

		teleportingSeller = false

		return false

	end


	--// FIND SELLER

	info.Text =
		"Invoking FindSeller..."


	local ok, found, listingId =
		pcall(function()

			return FindSellers:InvokeServer(
				"Pet",
				itemData
			)

		end)


	print("==============================")
	print("DIRECT FIND SELLER")
	print("==============================")
	print("OK:", ok)
	print("FOUND:", found)
	print("LISTING ID:", listingId)


	if not ok then

		warn(
			"FindSellers error:",
			found
		)

		info.Text =
			"FindSeller error"

		teleportingSeller = false

		return false

	end


	if not found
	or not listingId then

		info.Text =
			"Seller not found: "
			..selectedPet

		teleportingSeller = false

		return false

	end


	--// SAVE BEFORE TELEPORT

	getgenv().FindSellerListingId =
		listingId

	getgenv().FindSellerPet =
		selectedPet


	--// DIRECT TELEPORT

	info.Text =
		"Teleporting seller..."


	local tpOK, tpResult =
		pcall(function()

			return TeleportToListing:InvokeServer(
				listingId,
				true
			)

		end)


	print("==============================")
	print("TELEPORT TO LISTING")
	print("==============================")
	print("OK:", tpOK)
	print("RESULT:", tpResult)


	if not tpOK then

		warn(
			"TeleportToListing error:",
			tpResult
		)

		info.Text =
			"Teleport failed"

		clearFindSellerState()

		teleportingSeller = false

		return false

	end


	info.Text =
		"Seller found: "
		..selectedPet


	teleportingSeller = false

	return true

end


