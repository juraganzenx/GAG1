----------------------------------------------------------------
-- SAVE / LOAD
----------------------------------------------------------------
local function saveSettings(data)

	if writefile then

		pcall(function()

			writefile(
				SAVE_FILE,
				HttpService:JSONEncode(data)
			)

		end)

	end

end

local function loadSettings()

	if readfile and isfile and isfile(SAVE_FILE) then

		local ok,data = pcall(function()

			return HttpService:JSONDecode(
				readfile(SAVE_FILE)
			)

		end)

		if ok and data then
			return data
		end

	end

	return {}

end

local function saveAutoBuyStatus(state)

	if writefile then

		pcall(function()

			writefile(
				AUTO_BUY_FILE,
				state and "ON" or "OFF"
			)

		end)

	end

end

local function loadAutoBuyStatus()

	if isfile and isfile(AUTO_BUY_FILE) then

		local ok,data = pcall(readfile,AUTO_BUY_FILE)

		if ok and data then
			return data == "ON"
		end

	end

	return false

end

local function saveFindSellerTarget(target)

	if writefile then

		pcall(function()

			writefile(
				FIND_SELLER_FILE,
				target or ""
			)

		end)

	end

end

local function loadFindSellerTarget()

	if readfile and isfile and isfile(FIND_SELLER_FILE) then

		local ok,data = pcall(readfile,FIND_SELLER_FILE)

		if ok and data ~= "" then
			return data
		end

	end

	return nil

end

