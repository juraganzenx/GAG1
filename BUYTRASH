----------------------------------------------------------------
-- FIND SELLER STATE
----------------------------------------------------------------

local teleportingSeller = false

local function clearFindSellerState()
	getgenv().FindSellerListingId = nil
	getgenv().FindSellerPet = nil
end

----------------------------------------------------------------
-- READ LISTING AFTER TELEPORT
----------------------------------------------------------------

local function readFindSellerListing()
	local listingId = getgenv().FindSellerListingId
	local targetPet = getgenv().FindSellerPet

	if not listingId then
		return nil
	end

	print("================================")
	print("READ FIND SELLER LISTING")
	print("================================")
	print("Target Pet:", targetPet)
	print("Listing ID:", listingId)

	info.Text = "Reading seller data..."

	local data

	for attempt = 1, 50 do
		local ok, result = pcall(function()
			return BoothsReplication:GetDataAsync()
		end)

		if ok and result and result.Booths and result.Players then
			data = result
			break
		end

		task.wait(0.2)
	end

	if not data then
		warn("Booths data belum tersedia")
		info.Text = "Booths data unavailable"
		return nil
	end

	for boothUUID, booth in pairs(data.Booths or {}) do
		local ownerId = booth.Owner

		if ownerId then
			local playerData = data.Players[ownerId]

			if playerData and playerData.Listings then
				local listing = playerData.Listings[listingId]

				if listing then
					local item =
						playerData.Items
						and playerData.Items[listing.ItemId]

					print("================================")
					print("LISTING FOUND")
					print("================================")
					print("Booth UUID:", boothUUID)
					print("Owner ID:", ownerId)
					print("Listing ID:", listingId)
					print("Item ID:", listing.ItemId)
					print("Item Type:", listing.ItemType)
					print("PRICE:", listing.Price)

					if item then
						print("PetType:", item.PetType)
						print("Name:", item.Name)

						if item.PetData then
							print(
								"Mutation:",
								item.PetData.MutationType
							)

							print(
								"Level:",
								item.PetData.Level
							)

							print(
								"Weight:",
								item.PetData.BaseWeight
							)
						end
					end

					info.Text =
						("SELLER FOUND | $%s")
						:format(tostring(listing.Price))

					local result = {
						boothUUID = boothUUID,
						ownerId = ownerId,
						listingId = listingId,
						listing = listing,
						item = item,
						price = listing.Price
					}

					clearFindSellerState()

					return result
				end
			end
		end
	end

	warn(
		"Listing ID tidak ditemukan:",
		listingId
	)

	info.Text = "Listing not found"

	return nil
end

----------------------------------------------------------------
-- TELEPORT TO SELLER
----------------------------------------------------------------

local function teleportToSeller(selectedPet)

	if teleportingSeller then
		return
	end

	teleportingSeller = true

	---------------------------------------------------
	-- EGG -> FIRST PET
	---------------------------------------------------

	selectedPet = getFindSellerPet(selectedPet)

	if not selectedPet or selectedPet == "" then
		teleportingSeller = false
		return
	end

	info.Text =
		"Finding seller: " .. selectedPet

	---------------------------------------------------
	-- GET DEFAULT ITEM DATA
	---------------------------------------------------

	local dataOK, itemData = pcall(function()
		return RAPUtil.GetDefaultItemData(
			"Pet",
			selectedPet
		)
	end)

	if not dataOK or not itemData then
		warn(
			"GetDefaultItemData failed:",
			itemData
		)

		info.Text = "Item data error"

		teleportingSeller = false
		return
	end

	---------------------------------------------------
	-- FIND SELLER
	---------------------------------------------------

	local ok, found, listingId = pcall(function()
		return FindSellers:InvokeServer(
			"Pet",
			itemData
		)
	end)

	print("================================")
	print("FIND SELLER")
	print("================================")
	print("OK:", ok)
	print("FOUND:", found)
	print("LISTING ID:", listingId)

	if not ok then
		warn(
			"FindSellers error:",
			found
		)

		info.Text = "FindSeller error"

		teleportingSeller = false
		return
	end

	if not found or not listingId then
		info.Text =
			"Seller not found: " .. selectedPet

		teleportingSeller = false
		return
	end

	---------------------------------------------------
	-- SAVE STATE BEFORE TELEPORT
	---------------------------------------------------

	getgenv().FindSellerListingId = listingId
	getgenv().FindSellerPet = selectedPet

	print(
		"Saved Listing ID:",
		getgenv().FindSellerListingId
	)

	---------------------------------------------------
	-- TELEPORT TO LISTING
	---------------------------------------------------

	info.Text =
		"Teleporting to seller..."

	local tpOK, tpResult = pcall(function()
		return TeleportToListing:InvokeServer(
			listingId,
			true
		)
	end)

	print("================================")
	print("TELEPORT TO LISTING")
	print("================================")
	print("OK:", tpOK)
	print("RESULT:", tpResult)

	if not tpOK then
		warn(
			"TeleportToListing error:",
			tpResult
		)

		info.Text = "Teleport failed"

		clearFindSellerState()

		teleportingSeller = false
		return
	end

	info.Text =
		"Teleported to " .. selectedPet

	teleportingSeller = false
end

