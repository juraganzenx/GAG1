		pBox.Text =
			tostring(data.price)

		pBox.Font =
			Enum.Font.GothamBold

		pBox.TextSize =
			13

		pBox.BackgroundColor3 =
			Color3.fromRGB(55,55,55)

		pBox.TextColor3 =
			Color3.fromRGB(0,255,100)

		pBox.BorderSizePixel =
			0


		Instance.new("UICorner",pBox)


		pBox.FocusLost:Connect(function()

			local num =
				tonumber(pBox.Text)

			if not num then

				pBox.Text =
					tostring(data.price)

				return

			end


			data.price =
				num

			saveSettings(
				petDataList
			)

		end)


		local removeBtn =
			Instance.new("TextButton")

		removeBtn.Parent =
			container

		removeBtn.Size =
