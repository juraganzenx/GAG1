local function clearFindSellerState()

	getgenv().FindSellerListingId =
		nil

	getgenv().FindSellerPet =
		nil

end


--//========================================================
--// READ FIND SELLER LISTING
--//========================================================

local function readFindSellerListing()

	local listingId =
		getgenv().FindSellerListingId


	if not listingId then
		return nil
	end


	info.Text =
		"Reading seller data..."


	local data


	for attempt = 1, 50 do

		local ok, result =
			pcall(function()

				return BoothsReplication:
					GetDataAsync()

			end)


		if ok
		and result
		and result.Booths
		and result.Players then

			data =
				result

			break

		end


		task.wait(0.2)

	end


	if not data then

		info.Text =
			"Booths data unavailable"

		return nil

	end


	for boothUUID, booth in pairs(
		data.Booths or {}
	) do

		local ownerId =
			booth.Owner


		if ownerId then

			local playerData =
				data.Players[ownerId]


			if playerData
			and playerData.Listings then

				local listing =
					playerData.Listings[
						listingId
					]


				if listing then

					local item =
						playerData.Items
						and playerData.Items[
							listing.ItemId
						]


					local result = {

						boothUUID =
							boothUUID,

						ownerId =
							ownerId,

						listingId =
							listingId,

						listing =
							listing,

						item =
							item,

						price =
							listing.Price

					}


					clearFindSellerState()


					info.Text =
						("SELLER FOUND | $%s")
						:format(
							tostring(
								listing.Price
							)
						)


					return result

				end

			end

		end

	end


	info.Text =
		"Listing not found"


	return nil

end


--//========================================================
--// TELEPORT TO SELLER
--//========================================================

local function teleportToSeller(
	selectedPetName
)

	--//====================================================
	--// NEVER FIND SELLER DURING BUY
	--//====================================================

	if buying then

		print(
			"[FIND SELLER BLOCKED] BUYING"
		)

		return

	end


	if findingSeller then
		return
	end


	findingSeller =
		true


	local selectedPetLocal =
		getFindSellerPet(
			selectedPetName
		)


	if not selectedPetLocal
	or selectedPetLocal == "" then

		findingSeller =
			false

		return

	end


	info.Text =
		"Finding seller: "
		..selectedPetLocal


	--//====================================================
	--// ITEM DATA
	--//====================================================

	local dataOK, itemData =
		pcall(function()

			return RAPUtil.GetDefaultItemData(
				"Pet",
				selectedPetLocal
			)

		end)


	if not dataOK
	or not itemData then

		info.Text =
			"Item data error"

		findingSeller =
			false

		return

	end


	--//====================================================
	--// FIND SELLER
	--//====================================================

	local ok, found, listingId =
		pcall(function()

			return FindSellers:
				InvokeServer(
					"Pet",
					itemData
				)

		end)


	print(
		"[FIND SELLER]",
		"OK:",
		ok,
		"FOUND:",
		found,
		"LISTING:",
		listingId
	)


	if not ok then

		info.Text =
			"FindSeller error"

		findingSeller =
			false

		return

	end


	if not found
	or not listingId then

		info.Text =
			"Seller not found: "
			..selectedPetLocal

		findingSeller =
			false

		return

	end


	--//====================================================
	--// SAVE STATE
	--//====================================================

	getgenv().FindSellerListingId =
		listingId

	getgenv().FindSellerPet =
		selectedPetLocal


	--//====================================================
	--// TELEPORT
	--//====================================================

	info.Text =
		"Teleporting to seller..."


	local tpOK, tpResult =
		pcall(function()

			return TeleportToListing:
				InvokeServer(
					listingId,
					true
				)

		end)


	print(
		"[TELEPORT SELLER]",
		tpOK,
		tpResult
	)


	if not tpOK then

		info.Text =
			"Teleport failed"

		clearFindSellerState()

		findingSeller =
			false

		return

	end


	info.Text =
		"Teleported to "
		..selectedPetLocal


	findingSeller =
		false

end


--//========================================================
--// MATCH LISTING
--//========================================================

local function matchesWanted(
	name,
	item,
	listing,
	wanted
)

	--//====================================================
	--// NAME
	--//====================================================

	local wantedName =
		tostring(
			wanted.pet or ""
		):lower()


	local nameMatched =
		false


	if name ==
		wantedName then

		nameMatched =
			true

	end


	--//====================================================
	--// EGG GROUP
	--//====================================================

	if EggGroups[wanted.pet] then

		for _, eggPet in ipairs(
			EggGroups[wanted.pet]
		) do

			if name ==
				eggPet:lower() then

				nameMatched =
					true

				break

			end

		end

	end


	if not nameMatched then

		return false,
			"NAME"

	end


	--//====================================================
	--// PRICE
	--//====================================================

	local maxPrice =
		tonumber(
			wanted.price
		) or 1


	local listingPrice =
		tonumber(
			listing.Price
		) or math.huge


	if listingPrice >
		maxPrice then

		return false,
			"PRICE"

	end


	--//====================================================
	--// WEIGHT
	--//====================================================

	local minWeight =
		tonumber(
			wanted.minWeight
		) or 0.1


	if minWeight <= 0 then
		minWeight = 0.1
	end


	local itemWeight =
		getBaseWeight(
			item
		)


	if itemWeight <
		minWeight then

		return false,
			"WEIGHT"

	end


	--//====================================================
	--// LEVEL
	--//====================================================

	local minLevel =
		tonumber(
			wanted.minLevel
		) or 1


	if minLevel <= 0 then
		minLevel = 1
	end


	local itemLevel =
		getLevel(
			item
		)


	if itemLevel <
		minLevel then

		return false,
			"LEVEL"

	end


	--//====================================================
	--// MUTATION
	--//====================================================

	local wantedMutation =
		tostring(
			wanted.mutation or ""
		):lower()


	local itemMutation =
		getMutationType(
			item
		):lower()


	if wantedMutation ~= ""
	and wantedMutation ~= "any" then

		if itemMutation ~=
			wantedMutation then

			return false,
				"MUTATION"

		end

	end


	return true,
		"MATCH"

end


--//========================================================
--// SCAN LISTINGS
--//========================================================

local function scanListings()

	table.clear(
		matchedListings
	)


	local ok, data =
		pcall(function()

			return BoothsReplication:
				GetDataAsync()

		end)


	if not ok
	or not data then

		info.Text =
			"Booths data unavailable"

		return 0

	end


	local checked =
		0


	for _, booth in pairs(
		data.Booths or {}
	) do

		local ownerId =
			booth.Owner


		local pData =
			ownerId
			and data.Players
			and data.Players[
				ownerId
			]


		if pData then

			for uuid, listing in pairs(
				pData.Listings or {}
			) do

				local item =
					pData.Items
					and pData.Items[
						listing.ItemId
					]


				if item then

					checked += 1


					local rawName =
						item.Name
						or item.PetType
						or ""


					local success,
						resolvedName =
						pcall(function()

							return ItemNameFinder(
								rawName,
								listing.ItemType
							)

						end)


					local name


					if success
					and resolvedName then

						name =
							tostring(
								resolvedName
							):lower()

					else

						name =
							tostring(
								rawName
							):lower()

					end


					--//================================================
					--// CHECK ALL TARGETS
					--//================================================

					for wantedIndex, wanted in ipairs(
						petDataList
					) do

						local matched =
							matchesWanted(
								name,
								item,
								listing,
								wanted
							)


						if matched then

							local owner


							pcall(function()

								owner =
									TradeBoothsData:
									getPlayerById(
										ownerId
									)

							end)


							if owner then

								local itemWeight =
									getBaseWeight(
										item
									)


								local itemLevel =
									getLevel(
										item
									)


								local itemMutation =
									getMutationType(
										item
									)


								table.insert(
									matchedListings,
									{

										owner =
											owner,

										uuid =
											uuid,

										wanted =
											wanted,

										wantedIndex =
											wantedIndex,

										name =
											name,

										price =
											listing.Price,

										weight =
											itemWeight,

										level =
											itemLevel,

										mutation =
											itemMutation

									}
								)


								print(
									"[MATCH]",
									name,
									"| $",
									listing.Price,
									"| KG:",
									itemWeight,
									"| LV:",
									itemLevel,
									"| MUT:",
									itemMutation
								)


								break

							end

						end

					end

				end

			end

		end

	end


	print(
		"[SCAN]",
		"Checked:",
		checked,
		"Matched:",
		#matchedListings
	)


	info.Text =
		("SCAN | Match: %d")
		:format(
			#matchedListings
		)


	return #matchedListings

end


--//========================================================
--// BUY ALL MATCH
--//========================================================

local function buyAllMatch()

	--//====================================================
	--// PREVENT DOUBLE RUN
	--//====================================================

	if buying
	or scanning
	or findingSeller then

		return

	end


	--//====================================================
	--// LOCK SCAN
	--//====================================================

	scanning =
		true


	--//====================================================
	--// THREE SCAN ATTEMPTS
	--//====================================================

	local totalMatches =
		0


	for attempt = 1, 3 do

		if not autoBuying
		and attempt > 1 then

			break

		end


		info.Text =
			("Scanning %d/3...")
			:format(
				attempt
			)


		totalMatches =
			scanListings()


		--//================================================
		--// FOUND
		--//================================================

		if totalMatches > 0 then

			break

		end


		--//================================================
		--// NOT FOUND
		--//================================================

		if attempt < 3 then

			info.Text =
				("No match | Rescan %d/3")
				:format(
					attempt + 1
				)


			task.wait(1)

		end

	end


	--//====================================================
	--// UNLOCK SCAN
	--//====================================================

	scanning =
		false


	--//====================================================
	--// STILL NO LISTING
	--//====================================================

	if #matchedListings <= 0 then

		info.Text =
			"No listing after 3 scans"


		--// IMPORTANT:
		--// Only now Find Seller.

		if selectedFindSellerPet
		and selectedFindSellerPet ~= "" then

			task.spawn(function()

				teleportToSeller(
					selectedFindSellerPet
				)

			end)

		end


		return

	end


	--//====================================================
	--// BUY LOCK
	--//====================================================

	buying =
		true


	--//====================================================
	--// BUY MATCHES
	--//====================================================

	for i, v in ipairs(
		matchedListings
	) do

		--// Never Find Seller during this loop.

		info.Text =
			("BUY %d/%d | %s | $%s")
			:format(

				i,

				#matchedListings,

				tostring(
					v.name
				),

				tostring(
					v.price
				)

			)


		print(
			"[BUY]",
			i,
			"/",
			#matchedListings,
			v.name,
			"$",
			v.price
		)


		local buyOK,
			buyResult =
			pcall(function()

				return TradeEvents
					.Booths
					.BuyListing
					:InvokeServer(
						v.owner,
						v.uuid
					)

			end)


		if buyOK then

			print(
				"[BUY SUCCESS]",
				v.name,
				v.price
			)

		else

			warn(
				"[BUY FAILED]",
				v.name,
				buyResult
			)

		end


		task.wait(2)

	end


	--//====================================================
	--// CLEAR BUY LOCK
	--//====================================================

	buying =
		false


	info.Text =
		("BUY COMPLETE | %d")
		:format(
			#matchedListings
		)


	--//====================================================
	--// IMPORTANT:
	--// NO FIND SELLER HERE.
	--//
	--// Auto loop will call this function again.
	--// Next cycle scans listings first.
	--//====================================================

end


