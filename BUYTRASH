local function clearResults()

    for _, v in ipairs(resultFrame:GetChildren()) do

        if v:IsA("TextButton") then
            v:Destroy()
        end

    end

end

local function refreshSearch()

    clearResults()

    local text =
        tostring(searchBox.Text or ""):lower()

    if text == "" then
        return
    end

    --// EGG GROUP

    for eggName in pairs(EggGroups) do

        if string.find(
            eggName:lower(),
            text,
            1,
            true
        ) then

            local btn =
                Instance.new("TextButton")

            btn.Parent =
                resultFrame

            btn.Size =
                UDim2.new(1,-5,0,30)

            btn.Text =
                "[EGG] "
                ..eggName

            btn.Font =
                Enum.Font.GothamBold

            btn.TextSize = 13

            btn.BackgroundColor3 =
                Color3.fromRGB(80,60,20)

            btn.TextColor3 =
                Color3.fromRGB(255,220,100)

            btn.BorderSizePixel = 0

            Instance.new("UICorner", btn)

            btn.Activated:Connect(function()

                selectedPet =
                    eggName

                searchBox.Text =
                    eggName

                clearResults()

            end)

        end

    end

    --// PET LIST

    if not PetList then
        updateCanvas()
        return
    end

    local count = 0

    for petName in pairs(PetList) do

        if string.find(
            tostring(petName):lower(),
            text,
            1,
            true
        ) then

            count += 1

            if count > 70 then
                break
            end

            local btn =
                Instance.new("TextButton")

            btn.Parent =
                resultFrame

            btn.Size =
                UDim2.new(1,-5,0,30)

            btn.Text =
                tostring(petName)

            btn.Font =
                Enum.Font.Gotham

            btn.TextSize = 13

            btn.BackgroundColor3 =
                Color3.fromRGB(45,45,45)

            btn.TextColor3 =
                Color3.new(1,1,1)

            btn.BorderSizePixel = 0

            Instance.new("UICorner", btn)

            btn.Activated:Connect(function()

                selectedPet =
                    petName

                searchBox.Text =
                    petName

                clearResults()

            end)

        end

    end

    updateCanvas()

end

searchBox:GetPropertyChangedSignal(
