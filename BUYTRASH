--//========================================================

local function startAutoLoop()

    if autoLoopRunning then
        return
    end

    autoLoopRunning = true

    task.spawn(function()

        while autoBuying do

            if not buying then

                local ok, err =
                    pcall(function()

                        buyAllMatch()

                    end)

                if not ok then

                    warn(
                        "[BUY LISTING] AUTO ERROR:",
                        err
                    )

                    buying = false

                end

            end

            task.wait(3)

        end

        autoLoopRunning = false

    end)

end

