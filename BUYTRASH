--//========================================================
--// SINGLE AUTO LOOP
--//========================================================

local function startAutoLoop()

	if autoLoopRunning then
		return
	end


	autoLoopRunning = true


	task.spawn(function()


		while autoBuying do


			--// PROTECTION

			if not buying then

				local ok, err =
					pcall(function()

						buyAllMatch()

					end)


				if not ok then

					warn(
						"AUTO BUY ERROR:",
						err
					)

					buying = false

				end

			end


			--// IMPORTANT:
			--// SHORT WAIT
			--// BUT NOT ZERO
			--// TO ALLOW SERVER DATA UPDATE

			task.wait(3)

		end


		autoLoopRunning = false

	end)

end


