				170,0,0
			)

		removeBtn.TextColor3 =
			Color3.new(1,1,1)

		removeBtn.BorderSizePixel = 0

		Instance.new("UICorner", removeBtn)


		removeBtn.Activated:Connect(function()

			table.remove(
				petDataList,
				i
			)

			saveSettings(
				petDataList
			)

			if selectedFindSellerPet ==
				data.pet then

				selectedFindSellerPet = nil

				saveFindSellerTarget("")

			end

			refreshPetList()

		end)

	end


	updateCanvas()

end


