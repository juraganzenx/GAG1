local SAVE_FILE =
	"AutoBUYLISTINGHUGE.txt"

local AUTO_BUY_FILE =
	"AutoBuyStatusHUGE.txt"

local FIND_SELLER_FILE =
	"FindSellerTargetHUGE.txt"


--========================================================
-- SAVE SETTINGS
--========================================================

local function saveSettings(data)

	if not writefile then
		return
	end

	pcall(function()

		writefile(
			SAVE_FILE,
			HttpService:JSONEncode(data)
		)

	end)

end


local function loadSettings()

	if readfile
	and isfile
	and isfile(SAVE_FILE) then

		local ok, data = pcall(function()

			return HttpService:JSONDecode(
				readfile(SAVE_FILE)
			)

		end)

		if ok and type(data) == "table" then

			return data

		end

	end

	return {}

end


--========================================================
-- AUTO BUY SAVE
--========================================================

local function saveAutoBuyStatus(state)

	if not writefile then
		return
	end

	pcall(function()

		writefile(
			AUTO_BUY_FILE,
			state and "ON" or "OFF"
		)

	end)

end


local function loadAutoBuyStatus()

	if isfile
	and readfile
	and isfile(AUTO_BUY_FILE) then

		local ok, data =
			pcall(readfile, AUTO_BUY_FILE)

		if ok then
			return data == "ON"
		end

	end

	return false

end


--========================================================
-- FIND SELLER SAVE
--========================================================

local function saveFindSellerTarget(target)

	if not writefile then
		return
	end

	pcall(function()

		writefile(
			FIND_SELLER_FILE,
			target or ""
		)

	end)

end


local function loadFindSellerTarget()

	if readfile
	and isfile
	and isfile(FIND_SELLER_FILE) then

		local ok, data =
			pcall(readfile, FIND_SELLER_FILE)

		if ok
		and data
		and data ~= "" then

			return data

		end

	end

	return nil

end


