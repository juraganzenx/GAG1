--//========================================================
--// BUY STATE
--//========================================================

local buying = false

local matchedListings = {}


--//========================================================
--// MATCH ITEM
--//========================================================

local function isPetMatch(
	itemName,
	wantedPet
)

	local normalName =
		itemName:lower()

	local target =
		tostring(
			wantedPet or ""
		):lower()


	--// NORMAL

	if normalName == target then
		return true
	end


	--// EGG GROUP

	if EggGroups[wantedPet] then

		for _, eggPet in ipairs(
			EggGroups[wantedPet]
		) do

			if normalName ==
				eggPet:lower() then

				return true

			end

		end

	end


	return false

end


--//========================================================
--// SCAN LISTINGS
--//========================================================

local function scanListings()

	table.clear(
		matchedListings
	)


	info.Text =
		"Scanning listings..."


	local ok, data =
		pcall(function()

			return BoothsReplication:GetDataAsync()

		end)


	if not ok
	or not data then

		info.Text =
			"Booths data unavailable"

		return 0

	end


	for _, booth in pairs(
		data.Booths or {}
	) do


		local ownerId =
			booth.Owner


		local pData =
			ownerId
			and data.Players
			and data.Players[ownerId]


		if pData then


			for uuid, listing in pairs(
				pData.Listings or {}
			) do


				local item =
					pData.Items
					and pData.Items[
						listing.ItemId
					]


				if item then


					local rawName =
						item.Name
						or item.PetType
						or ""


					local name =
						ItemNameFinder(
							rawName,
							listing.ItemType
						)


					name =
						tostring(name or "")


					--// ITEM STATS

					local itemWeight =
						getBaseWeight(item)


					local itemLevel =
						getLevel(item)


					local itemMutation =
						getMutationType(item)


					--// CHECK EVERY WANTED

					for _, wanted in ipairs(
						petDataList
					) do


						--// PET MATCH

						local matched =
							isPetMatch(
								name,
								wanted.pet
							)


						if matched then


							--//================================================
							--// IMPORTANT:
							--// USE SAVED SETTING PER LISTING
							--// NOT GLOBAL TEXTBOX
							--//================================================

							local minWeight =
								tonumber(
									wanted.minWeight
								) or 0


							local minLevel =
								tonumber(
									wanted.minLevel
								) or 0


							local wantedPrice =
								tonumber(
									wanted.price
								) or math.huge


							--// MUTATION

							local wantedMutation =
								tostring(
									wanted.mutation
									or ""
								):lower()


							local actualMutation =
								tostring(
									itemMutation
									or ""
								):lower()


							local mutationMatched =
								(
									wantedMutation == ""
									or wantedMutation == "any"
									or actualMutation ==
										wantedMutation
								)


							--// PRICE

							local price =
								tonumber(
									listing.Price
								) or math.huge


							--// FINAL MATCH

							if price <= wantedPrice
							and itemWeight >= minWeight
							and itemLevel >= minLevel
							and mutationMatched then


								local owner =
									TradeBoothsData.getPlayerById(
										ownerId
									)


								if owner then


									table.insert(
										matchedListings,
										{

											owner =
												owner,

											uuid =
												uuid,

											name =
												name,

											price =
												price,

											weight =
												itemWeight,

											level =
												itemLevel,

											mutation =
												itemMutation,

											wanted =
												wanted

										}
									)


									print(
										"================================"
									)

									print(
										"MATCH FOUND"
									)

									print(
										"Pet:",
										name
									)

									print(
										"Price:",
										price
									)

									print(
										"Weight:",
										itemWeight
									)

									print(
										"Level:",
										itemLevel
									)

									print(
										"Mutation:",
										itemMutation
									)

									print(
										"Target:",
										wanted.pet
									)


									--// ONE LISTING
									--// SHOULD NOT MATCH
									--// SAME WANTED AGAIN

									break

								end

							end

						end

					end

				end

			end

		end

	end


	info.Text =
		"Found "
		..#matchedListings
		.." listing(s)"


	return #matchedListings

end


--//========================================================
--// BUY ONE LISTING
--//========================================================

local function buyListing(
	listingData
)

	if not listingData then
		return false
	end


	local success, result =
		pcall(function()

			return TradeEvents
				.Booths
				.BuyListing
				:InvokeServer(
					listingData.owner,
					listingData.uuid
				)

		end)


	print("==============================")
	print("BUY LISTING")
	print("==============================")
	print("Pet:", listingData.name)
	print("Price:", listingData.price)
	print("UUID:", listingData.uuid)
	print("SUCCESS:", success)
	print("RESULT:", result)


	return success

end


--//========================================================
--// BUY ALL MATCH
--//========================================================
--//
--// IMPORTANT:
--// NO FIND SELLER UNTIL SCAN HAS
--// COMPLETELY FINISHED AND FOUND ZERO MATCH.
--//
--//========================================================

local function buyAllMatch()

	if buying then
		return false
	end


	buying = true


	--//======================================================
	--// FIRST SCAN
	--//======================================================

	local count =
		scanListings()


	--//======================================================
	--// FOUND LISTING
	--//
	--// BUY FIRST.
	--// DO NOT FIND SELLER.
	--//======================================================

	if count > 0 then


		for i, listingData in ipairs(
			matchedListings
		) do


			info.Text =
				("BUYING %d/%d | %s")
				:format(
					i,
					count,
					listingData.name
				)


			local bought =
				buyListing(
					listingData
				)


			if bought then

				info.Text =
					("BOUGHT %s | $%s")
					:format(
						listingData.name,
						tostring(
							listingData.price
						)
					)

			else

				info.Text =
					("BUY FAILED | %s")
					:format(
						listingData.name
					)

			end


			--// WAIT SERVER UPDATE

			task.wait(2)

		end


		--//==================================================
		--// IMPORTANT:
		--// AFTER BUY, JUST RETURN.
		// AUTO LOOP WILL SCAN AGAIN.
		// NO FIND SELLER HERE.
		--//==================================================

		buying = false

		return true

	end


	--//======================================================
	--// ZERO MATCH
	--//
	--// ONLY NOW FIND SELLER
	--//======================================================

	info.Text =
		"No matching listing"


	if selectedFindSellerPet
	and selectedFindSellerPet ~= "" then


		task.wait(0.5)


		info.Text =
			"No listing - Find Seller"


		teleportToSeller(
			selectedFindSellerPet
		)

	else

		info.Text =
			"No listing / No FindSeller target"

	end


	buying = false

	return false

end


