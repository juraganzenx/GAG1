----------------------------------------------------------------
-- BUY LOGIC
----------------------------------------------------------------
local buying = false
local matchedListings = {}

local function scanListings()

	table.clear(matchedListings)

	local data = BoothsReplication:GetDataAsync()

	if not data then
		return
	end

	for _,booth in pairs(data.Booths or {}) do

		local ownerId = booth.Owner
		local pData = ownerId and data.Players[ownerId]

		if pData then

			for uuid,listing in pairs(pData.Listings or {}) do

				local item = pData.Items[listing.ItemId]

				if item then

					local name = ItemNameFinder(
						item.Name or item.PetType or "",
						listing.ItemType
					):lower()

					for _,wanted in ipairs(petDataList) do

						local matched = false

						------------------------------------------------
						-- NORMAL PET
						------------------------------------------------
						if name == wanted.pet:lower() then
							matched = true
						end

						------------------------------------------------
						-- EGG GROUP
						------------------------------------------------
						if EggGroups[wanted.pet] then

							for _,eggPet in ipairs(EggGroups[wanted.pet]) do

								if name == eggPet:lower() then
									matched = true
									break
								end

							end

						end

						------------------------------------------------
						-- BUY
						------------------------------------------------
						local itemWeight = getBaseWeight(item)
						local itemLevel = getLevel(item)
						local itemMutation = getMutationType(item)

						local inputWeight = tonumber(minWeightBox.Text) or 6.17
						local minWeight = inputWeight > 0 and (inputWeight / 1.1) or 6.17
						local minLevel = tonumber(minLevelBox.Text) or 100

						local wantedMutation =
							tostring(wanted.mutation or ""):lower()

						local mutationMatched = true

						if wantedMutation ~= ""
						and wantedMutation ~= "any" then

							mutationMatched =
								itemMutation:lower() == wantedMutation

						end

						if matched
						and listing.Price <= wanted.price
						and itemWeight >= minWeight
						and itemLevel >= minLevel
						and mutationMatched then

							info.Text =
							("FOUND %s | L:%s | KG:%s | M:%s")
							:format(
								name,
								tostring(itemLevel),
								tostring(itemWeight),
								tostring(itemMutation)
							)

							table.insert(matchedListings,{
								owner = TradeBoothsData.getPlayerById(ownerId),
								uuid = uuid
							})

							break

						end

					end

				end

			end

		end

	end

	info.Text = "Found "..#matchedListings

end

local function buyAllMatch()

	if buying then
		return
	end

	scanListings()

	if #matchedListings <= 0 then

		info.Text = "No Listing"

		if selectedFindSellerPet then
			teleportToSeller(selectedFindSellerPet)
		end

		return
	end

	buying = true

	for i,v in ipairs(matchedListings) do

		info.Text =
			("Buying %d/%d")
			:format(i,#matchedListings)

		pcall(function()

			TradeEvents.Booths.BuyListing:InvokeServer(
				v.owner,
				v.uuid
			)

		end)

		task.wait(2)

	end

	buying = false

	info.Text = "Finished Buying"

	task.wait(1)

	if selectedFindSellerPet then
		teleportToSeller(selectedFindSellerPet)
	end

end

