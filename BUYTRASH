local function refreshPetList()

	for _,v in ipairs(listFrame:GetChildren()) do

		if v:IsA("Frame") then
			v:Destroy()
		end

	end

	for i,data in ipairs(petDataList) do

		local container = Instance.new("Frame")
		container.Parent = listFrame
		container.Size = UDim2.new(1,-8,0,38)
		container.BackgroundColor3 = Color3.fromRGB(40,40,40)
		container.BorderSizePixel = 0
		Instance.new("UICorner",container)

		local nameBtn = Instance.new("TextButton")
		nameBtn.Parent = container
		nameBtn.Size = UDim2.new(0.58,0,1,0)
		nameBtn.Position = UDim2.new(0.03,0,0,0)
		nameBtn.BackgroundTransparency = 1
		nameBtn.TextXAlignment = Enum.TextXAlignment.Left
		nameBtn.Font = Enum.Font.GothamBold
		nameBtn.TextSize = 13
		nameBtn.Text =
			data.pet..
			" | $"..tostring(data.price)..
			" | KG:"..tostring(data.minWeight or 0.1)..
			" | LV:"..tostring(data.minLevel or 1)..
			" | M:"..(
				(data.mutation ~= nil and data.mutation ~= "")
				and data.mutation
				or "Any"
			)

		if selectedFindSellerPet == data.pet then
			nameBtn.TextColor3 = Color3.fromRGB(0,255,100)
		else
			nameBtn.TextColor3 = Color3.new(1,1,1)
		end

		nameBtn.Activated:Connect(function()

			selectedFindSellerPet = data.pet

			saveFindSellerTarget(data.pet)

			info.Text = "FindSeller : "..data.pet

			refreshPetList()

		end)

		local pBox = Instance.new("TextBox")
		pBox.Parent = container
		pBox.Size = UDim2.new(0.22,0,0.75,0)
		pBox.Position = UDim2.new(0.60,0,0.125,0)
		pBox.Text = tostring(data.price)
		pBox.Font = Enum.Font.GothamBold
		pBox.TextSize = 13
		pBox.BackgroundColor3 = Color3.fromRGB(55,55,55)
		pBox.TextColor3 = Color3.fromRGB(0,255,100)
		pBox.BorderSizePixel = 0
		Instance.new("UICorner",pBox)

		pBox.FocusLost:Connect(function()

			local num = tonumber(pBox.Text)

			if not num then
				pBox.Text = tostring(data.price)
				return
			end

			data.price = num

			saveSettings(petDataList)

		end)

		local removeBtn = Instance.new("TextButton")
		removeBtn.Parent = container
		removeBtn.Size = UDim2.new(0,28,0,28)
		removeBtn.Position = UDim2.new(1,-35,0.5,-14)
		removeBtn.Text = "-"
		removeBtn.Font = Enum.Font.GothamBold
		removeBtn.TextSize = 18
		removeBtn.BackgroundColor3 = Color3.fromRGB(170,0,0)
		removeBtn.TextColor3 = Color3.new(1,1,1)
		removeBtn.BorderSizePixel = 0
		Instance.new("UICorner",removeBtn)

		removeBtn.Activated:Connect(function()

			table.remove(petDataList,i)

			saveSettings(petDataList)

			refreshPetList()

		end)

	end

	updateCanvas()

end

