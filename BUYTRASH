--========================================================
-- BUY LOGIC
--========================================================

local buying =
	false


local matchedListings =
	{}


--========================================================
-- CHECK NAME AGAINST WANTED
--========================================================

local function isWantedName(
	itemName,
	wantedName
)

	itemName =
		itemName:lower()


	wantedName =
		wantedName:lower()


	-- NORMAL

	if itemName ==
		wantedName then

		return true

	end


	-- EGG GROUP

	local group =
		EggGroups[wantedName]


	if group then

		for _, petName in ipairs(
			group
		) do

			if itemName ==
				petName:lower() then

				return true

			end

		end

	end


	return false

end


--========================================================
-- SCAN LISTINGS
--========================================================

local function scanListings()

	table.clear(
		matchedListings
	)


	info.Text =
		"Scanning..."


	local data


	local ok =
		pcall(function()

			data =
				BoothsReplication:GetDataAsync()

		end)


	if not ok
	or not data then

		info.Text =
			"Booth data unavailable"

		return

	end


	if not data.Booths
	or not data.Players then

		info.Text =
			"Booth data incomplete"

		return

	end


	--====================================================
	-- SCAN BOOTHS
	--====================================================

	for _, booth in pairs(
		data.Booths
	) do

		local ownerId =
			booth.Owner


		local pData =
			ownerId
			and data.Players[ownerId]


		if pData then

			for uuid, listing in pairs(
				pData.Listings or {}
			) do

				local item =
					pData.Items
					and pData.Items[
						listing.ItemId
					]


				if item then

					--========================================
					-- ITEM NAME
					--========================================

					local rawName =
						item.Name
						or item.PetType
						or ""


					local name

					local nameOk =
						pcall(function()

							name =
								ItemNameFinder(
									rawName,
									listing.ItemType
								)

						end)


					if not nameOk
					or not name then

						name =
							rawName

					end


					name =
						tostring(name)


					--========================================
					-- ITEM DATA
					--========================================

					local itemWeight =
						getBaseWeight(item)


					local itemLevel =
						getLevel(item)


					local itemMutation =
						getMutationType(item)


					local listingPrice =
						tonumber(
							listing.Price
						)


					if listingPrice then

						--====================================
						-- CHECK EACH WANTED
						--====================================

						for _, wanted in ipairs(
							petDataList
						) do

							local matched =
								isWantedName(
									name,
									tostring(
										wanted.pet
										or ""
									)
								)


							if matched then

								--================================
								-- IMPORTANT:
								-- USE SAVED SETTING
								-- NOT TEXTBOX
								--================================

								local maxPrice =
									tonumber(
										wanted.price
									)
									or 1


								local minWeight =
									tonumber(
										wanted.minWeight
									)
									or 0.1


								local minLevel =
									tonumber(
										wanted.minLevel
									)
									or 1


								local wantedMutation =
									tostring(
										wanted.mutation
										or ""
									)


								wantedMutation =
									wantedMutation:lower()


								--================================
								-- MUTATION
								--================================

								local mutationMatched =
									true


								if wantedMutation ~= ""
								and wantedMutation ~= "any"
								and wantedMutation ~= "none" then

									mutationMatched =
										itemMutation:lower()
										==
										wantedMutation

								end


								--================================
								-- ALL CONDITIONS
								--================================

								local priceMatched =
									listingPrice
									<=
									maxPrice


								local weightMatched =
									itemWeight
									>=
									minWeight


								local levelMatched =
									itemLevel
									>=
									minLevel


								--================================
								-- DEBUG
								--================================

								if priceMatched
								and weightMatched
								and levelMatched
								and mutationMatched then

									--============================
									-- MATCH
									--============================

									local owner


									pcall(function()

										owner =
											TradeBoothsData
											.getPlayerById(
												ownerId
											)

									end)


									if owner then

										info.Text =
											(
												"FOUND %s | $%s | KG:%s | LV:%s | M:%s"
											):format(

												name,

												tostring(
													listingPrice
												),

												tostring(
													itemWeight
												),

												tostring(
													itemLevel
												),

												tostring(
													itemMutation
												)

											)


										table.insert(
											matchedListings,
											{

												owner =
													owner,

												uuid =
													uuid,

												name =
													name,

												price =
													listingPrice,

												weight =
													itemWeight,

												level =
													itemLevel,

												mutation =
													itemMutation

											}
										)

									end

									break

								end

							end

						end

					end

				end

			end

		end

	end


	info.Text =
		"Found "
		..#matchedListings

end


--========================================================
-- BUY ALL MATCH
--========================================================

local function buyAllMatch()

	if buying then
		return
	end


	--====================================================
	-- SCAN FIRST
	--====================================================

	scanListings()


	--====================================================
	-- NO MATCH
	--====================================================

	if #matchedListings <= 0 then

		info.Text =
			"No Listing"


		-- ONLY NOW FIND SELLER

		if selectedFindSellerPet then

			task.spawn(function()

				teleportToSeller(
					selectedFindSellerPet
				)

			end)

		end


		return

	end


	--====================================================
	-- BUY
	--====================================================

	buying =
		true


	local successful =
		0


	local failed =
		0


	for i, v in ipairs(
		matchedListings
	) do

		info.Text =
			(
				"Buying %d/%d | %s"
			):format(

				i,
				#matchedListings,
				v.name

			)


		local buyOk,
			result =
			pcall(function()

				return TradeEvents
					.Booths
					.BuyListing
					:InvokeServer(

						v.owner,
						v.uuid

					)

			end)


		if buyOk then

			successful += 1

		else

			failed += 1


			warn(
				"[BUY FAILED]",
				v.name,
				v.uuid,
				result
			)

		end


		task.wait(2)

	end


	buying =
		false


	--====================================================
	-- RESULT
	--====================================================

	if successful > 0 then

		info.Text =
			(
				"Bought %d | Failed %d"
			):format(
				successful,
				failed
			)

	else

		info.Text =
			"BUY FAILED"

	end


	--====================================================
	-- ONLY FIND SELLER AFTER BUY PROCESS
	--====================================================

	if selectedFindSellerPet then

		task.wait(1)


		task.spawn(function()

			teleportToSeller(
				selectedFindSellerPet
			)

		end)

	end

end


