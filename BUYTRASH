--// DIRECT FIND SELLER
--//
--// NO GUI CLICK
--//
--// 1. GetDefaultItemData
--// 2. FindSellers:InvokeServer
--// 3. TeleportToListing:InvokeServer
--//========================================================

local function teleportToSeller(targetPet)

    if teleportingSeller then
        return false
    end

    teleportingSeller = true

    local selected =
        getFindSellerPet(targetPet)

    if not selected
    or selected == "" then

        teleportingSeller = false

        return false

    end

    info.Text =
        "Finding seller: "
        ..tostring(selected)

    --//====================================================
    --// GET DEFAULT ITEM DATA
    --//====================================================

    if not RAPUtil then

        info.Text =
            "RAPUtil unavailable"

        teleportingSeller = false

        return false

    end

    local dataOK, itemData =
        pcall(function()

            return RAPUtil.GetDefaultItemData(
                "Pet",
                selected
            )

        end)

    if not dataOK
    or not itemData then

        warn(
            "[BUY LISTING] GetDefaultItemData failed:",
            itemData
        )

        info.Text =
            "Item data error"

        teleportingSeller = false

        return false

    end

    --//====================================================
    --// CHECK REMOTE
    --//====================================================

    if not FindSellers then

        warn(
            "[BUY LISTING] FindSellers remote not found"
        )

        info.Text =
            "FindSellers remote missing"

        teleportingSeller = false

        return false

    end

    if not TeleportToListing then

        warn(
            "[BUY LISTING] TeleportToListing remote not found"
        )

        info.Text =
            "Teleport remote missing"

        teleportingSeller = false

        return false

    end

    --//====================================================
    --// DIRECT FIND SELLER
    --//====================================================

    info.Text =
        "Invoking FindSeller..."

    local ok, found, listingId =
        pcall(function()

            return FindSellers:InvokeServer(
                "Pet",
                itemData
            )

        end)

    print(
        "================================"
    )

    print(
        "DIRECT FIND SELLER"
    )

    print(
        "Pet:",
        selected
    )

    print(
        "OK:",
        ok
    )

    print(
        "FOUND:",
        found
    )

    print(
        "LISTING ID:",
        listingId
    )

    print(
        "================================"
    )

    if not ok then

        warn(
            "[BUY LISTING] FindSellers error:",
            found
        )

        info.Text =
            "FindSeller error"

        teleportingSeller = false

        return false

    end

    if not found
    or not listingId then

        info.Text =
            "Seller not found: "
            ..tostring(selected)

        teleportingSeller = false

        return false

    end

    --//====================================================
    --// SAVE STATE
    --//====================================================

    getgenv().FindSellerListingId =
        listingId

    getgenv().FindSellerPet =
        selected

    --//====================================================
    --// DIRECT TELEPORT
    --//====================================================

    info.Text =
        "Teleporting seller..."

    local tpOK, tpResult =
        pcall(function()

            return TeleportToListing:InvokeServer(
                listingId,
                true
            )

        end)

    print(
        "================================"
    )

    print(
        "TELEPORT TO LISTING"
    )

    print(
        "OK:",
        tpOK
    )

    print(
        "RESULT:",
        tpResult
    )

    print(
        "================================"
    )

    if not tpOK then

        warn(
            "[BUY LISTING] TeleportToListing error:",
            tpResult
        )

        info.Text =
            "Teleport failed"

        clearFindSellerState()

        teleportingSeller = false

        return false

    end

    info.Text =
        "Seller found: "
        ..tostring(selected)

    teleportingSeller = false

    return true

end

--//========================================================
--// MATCHED LISTINGS
--//========================================================

local buying = false

local matchedListings = {}

--//========================================================
--// MATCH PET
--//========================================================

local function isPetMatch(
    itemName,
    wantedPet
)

    local normalName =
        tostring(itemName or ""):lower()

    local target =
        tostring(wantedPet or ""):lower()

    if normalName == target then
        return true
    end

    if EggGroups[wantedPet] then

        for _, eggPet in ipairs(
            EggGroups[wantedPet]
        ) do

            if normalName ==
                tostring(eggPet):lower() then

                return true

            end

        end

    end

    return false

end

--//========================================================
--// SCAN LISTINGS
--//========================================================

local function scanListings()

    table.clear(
        matchedListings
    )

    info.Text =
        "Scanning listings..."

    if not BoothsReplication then

        info.Text =
            "Booths module unavailable"

        return 0

    end

    local ok, data =
        pcall(function()

            return BoothsReplication:GetDataAsync()

        end)

    if not ok
    or not data then

        info.Text =
            "Booths data unavailable"

        warn(
            "[BUY LISTING] Booth data error:",
            data
        )

        return 0

    end

    for _, booth in pairs(
        data.Booths or {}
    ) do

        local ownerId =
            booth.Owner

        local pData =
            ownerId
            and data.Players
            and data.Players[ownerId]

        if pData then

            for uuid, listing in pairs(
                pData.Listings or {}
            ) do

                local item =
                    pData.Items
                    and pData.Items[
                        listing.ItemId
                    ]

                if item then

                    local rawName =
                        item.Name
                        or item.PetType
                        or ""

                    local nameOK, nameResult =
                        pcall(function()

                            return ItemNameFinder(
                                rawName,
                                listing.ItemType
                            )

                        end)

                    local name =
                        nameOK
                        and tostring(nameResult or "")
                        or tostring(rawName)

                    local itemWeight =
                        getBaseWeight(item)

                    local itemLevel =
                        getLevel(item)

                    local itemMutation =
                        getMutationType(item)

                    for _, wanted in ipairs(
                        petDataList
                    ) do

                        if type(wanted) == "table" then

                            local matched =
                                isPetMatch(
                                    name,
                                    wanted.pet
                                )

                            if matched then

                                local minWeight =
                                    tonumber(
                                        wanted.minWeight
                                    ) or 0

                                local minLevel =
                                    tonumber(
                                        wanted.minLevel
                                    ) or 0

                                local wantedPrice =
                                    tonumber(
                                        wanted.price
                                    ) or math.huge

                                local wantedMutation =
                                    tostring(
                                        wanted.mutation
                                        or ""
                                    ):lower()

                                local actualMutation =
                                    tostring(
                                        itemMutation
                                        or ""
                                    ):lower()

                                local mutationMatched =
                                    (
                                        wantedMutation == ""
                                        or wantedMutation == "any"
                                        or actualMutation ==
                                            wantedMutation
                                    )

                                local price =
                                    tonumber(
                                        listing.Price
                                    ) or math.huge

                                if price <= wantedPrice
                                and itemWeight >= minWeight
                                and itemLevel >= minLevel
                                and mutationMatched then

                                    local owner

                                    pcall(function()

                                        owner =
                                            TradeBoothsData.getPlayerById(
                                                ownerId
                                            )

                                    end)

                                    if owner then

                                        table.insert(
                                            matchedListings,
                                            {

                                                owner =
                                                    owner,

                                                uuid =
                                                    uuid,

                                                name =
                                                    name,

                                                price =
                                                    price,

                                                weight =
                                                    itemWeight,

                                                level =
                                                    itemLevel,

                                                mutation =
                                                    itemMutation,

                                                wanted =
                                                    wanted

                                            }
                                        )

                                        print(
                                            "================================"
                                        )

                                        print(
                                            "MATCH FOUND"
                                        )

                                        print(
                                            "Pet:",
                                            name
                                        )

                                        print(
                                            "Price:",
                                            price
                                        )

                                        print(
                                            "Weight:",
                                            itemWeight
                                        )

                                        print(
                                            "Level:",
                                            itemLevel
                                        )

                                        print(
                                            "Mutation:",
                                            itemMutation
                                        )

                                        print(
                                            "Target:",
                                            wanted.pet
                                        )

                                        print(
                                            "================================"
                                        )

                                        break

                                    end

                                end

                            end

                        end

                    end

                end

            end

        end

    end

    info.Text =
        "Found "
        ..tostring(#matchedListings)
        .." listing(s)"

    return #matchedListings

end

--//========================================================
--// BUY ONE
--//========================================================

local function buyListing(
    listingData
)

    if not listingData then
        return false
    end

    if not TradeEvents then
        return false
    end

    local success, result =
        pcall(function()

            return TradeEvents
                .Booths
                .BuyListing
                :InvokeServer(
                    listingData.owner,
                    listingData.uuid
                )

        end)

    print(
        "=============================="
    )

    print(
        "BUY LISTING"
    )

    print(
        "Pet:",
        listingData.name
    )

    print(
        "Price:",
        listingData.price
    )

    print(
        "UUID:",
        listingData.uuid
    )

    print(
        "SUCCESS:",
        success
    )

    print(
        "RESULT:",
        result
    )

    print(
        "=============================="
    )

    return success

end

--//========================================================
--// BUY ALL MATCH
--//========================================================

local function buyAllMatch()

    if buying then
        return false
    end

    buying = true

    --//====================================================
    --// SCAN
    --//====================================================

    local count =
        scanListings()

    --//====================================================
    --// MATCH FOUND
    --//
    --// BUY ONLY
    --// NO FIND SELLER
    --//====================================================

    if count > 0 then

        for i, listingData in ipairs(
            matchedListings
        ) do

            info.Text =
                ("BUYING %d/%d | %s")
                :format(
                    i,
                    count,
                    tostring(
                        listingData.name
                    )
                )

            local bought =
                buyListing(
                    listingData
                )

            if bought then

                info.Text =
                    ("BOUGHT %s | $%s")
                    :format(
                        tostring(
                            listingData.name
                        ),
                        tostring(
                            listingData.price
                        )
                    )

            else

                info.Text =
                    ("BUY FAILED | %s")
                    :format(
                        tostring(
                            listingData.name
                        )
                    )

            end

            task.wait(2)

        end

        buying = false

        return true

    end

    --//====================================================
    --// ZERO MATCH
    --//
    --// ONLY HERE FIND SELLER
    --//====================================================

    info.Text =
        "No matching listing"

    if selectedFindSellerPet
    and selectedFindSellerPet ~= "" then

        task.wait(0.5)

        info.Text =
            "No listing - Find Seller"

        teleportToSeller(
            selectedFindSellerPet
        )

    else

        info.Text =
            "No listing / No FindSeller target"

    end

    buying = false

    return false

end

