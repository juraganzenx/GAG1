-- BALD + MIMIC CHECK
--==================================================

local function CheckBaldMimic()

    return

        CountActive(
            "Bald Eagle"
        )
        >= Config.BALD_TARGET

        and

        CountActive(
            "Mimic Octopus"
        )
        >= Config.MIMIC_TARGET

end


--==================================================
-- BUILD BALD + MIMIC
--==================================================

local function BuildBaldMimic()

    local Result = {}


    local Bald =
        GetPets(
            "Bald Eagle"
        )

    local Mimic =
        GetPets(
            "Mimic Octopus"
        )


    if #Bald <
        Config.BALD_TARGET then

        Log(
            "BALD:",
            #Bald,
            "/",
            Config.BALD_TARGET
        )

        return Result

    end


    if #Mimic <
        Config.MIMIC_TARGET then

        Log(
            "MIMIC:",
            #Mimic,
            "/",
            Config.MIMIC_TARGET
        )

        return Result

    end


    for i = 1,
        Config.BALD_TARGET do

        table.insert(
            Result,
            Bald[i]
        )

    end


    for i = 1,
        Config.MIMIC_TARGET do

        table.insert(
            Result,
            Mimic[i]
        )

    end


    return Result

end


--==================================================
-- SET BALD MIMIC
--==================================================

local function SetBaldMimic()

    SetState(
        "BALD + MIMIC"
    )


    for Attempt = 1, 10 do

        if not Running then
            return false
        end


        if TradeRunning then
            return false
        end


        if CheckBaldMimic() then
            return true
        end


        local Desired =
            BuildBaldMimic()


        if #Desired ~=
            Config.BALD_TARGET
            + Config.MIMIC_TARGET then

            return false

        end


        UnequipAllPets()


        for _, Pet in ipairs(
            Desired
        ) do

            if not Running
                or TradeRunning then

                return false

            end


            EquipPet(Pet)

        end


        task.wait(
            Config.AFTER_EQUIP_WAIT
        )


        if CheckBaldMimic() then
            return true
        end

    end


    return false

end


