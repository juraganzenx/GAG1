local function GetRandomPlantPosition()

    local Size =
        CanPlant.Size

    local CF =
        CanPlant.CFrame

    local X =
        (math.random() - 0.5)
        * Size.X

    local Z =
        (math.random() - 0.5)
        * Size.Z


    return (
        CF
        * CFrame.new(
            X,
            Size.Y / 2,
            Z
        )
    ).Position

end


