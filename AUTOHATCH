local function GetActivePetData()

    local ActivePetUI =
        PG:FindFirstChild(
            "ActivePetUI"
        )


    if not ActivePetUI then
        return {}
    end


    local Frame =
        ActivePetUI:FindFirstChild(
            "Frame"
        )

    local MainFrame =
        Frame
        and Frame:FindFirstChild(
            "Main"
        )

    local PetDisplay =
        MainFrame
        and MainFrame:FindFirstChild(
            "PetDisplay"
        )

    local ScrollingFrame =
        PetDisplay
        and PetDisplay:FindFirstChild(
            "ScrollingFrame"
        )


    if not ScrollingFrame then
        return {}
    end


    local Result = {}


    for _, PetFrame in ipairs(
        ScrollingFrame:GetChildren()
    ) do

        if PetFrame.Name ~=
            "Pet Template" then

            local PetMain =
                PetFrame:FindFirstChild(
                    "Main"
                )

            local PetType =
                PetMain
                and PetMain:FindFirstChild(
                    "PET_TYPE"
                )


            if PetType then

                table.insert(
                    Result,
                    {
                        UUID =
                            PetFrame.Name,

                        Name =
                            tostring(
                                PetType.Text
                            )
                    }
                )

            end

        end

    end


    return Result

end


