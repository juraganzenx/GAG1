local SaveBusy =
    false


local function SaveConfig()

    if SaveBusy then
        return
    end

    SaveBusy =
        true

    task.defer(function()

        pcall(function()

            if writefile then

                local Data = {

                    Config =
                        Config,

                    Running =
                        Running,

                    SelectedPets =
                        SelectedPets

                }

                writefile(
                    SAVE_FILE,
                    HttpService:JSONEncode(
                        Data
                    )
                )

            end

        end)

        SaveBusy =
            false

    end)

end


