--==================================================

local function GetValidTradeTarget()

    local LocalPeryton =
        GetLocalPerytonCount()


    if LocalPeryton <= 12 then

        return nil

    end


    for _, Username in ipairs(
        TradeTargets
    ) do

        local Target =
            Players:FindFirstChild(
                Username
            )


        if Target
            and Target ~= LP then

            local TargetPeryton =
                GetTargetPerytonCount(
                    Target
                )


            if TargetPeryton < 12 then

                return Target

            end

        end

    end


    return nil

end


