--==================================================
-- LOAD CONFIG
--==================================================

local SelectedPets = {}


local function LoadConfig()

    if not isfile then
        return
    end

    if not isfile(CONFIG_FILE) then
        return
    end

    local Success, Data = pcall(function()

        return HttpService:JSONDecode(
            readfile(CONFIG_FILE)
        )

    end)


    if not Success or type(Data) ~= "table" then
        return
    end


    -- CONFIG
    if type(Data.Config) == "table" then

        for Key, DefaultValue in pairs(Config) do

            if Data.Config[Key] ~= nil
                and type(Data.Config[Key]) == type(DefaultValue) then

                Config[Key] =
                    Data.Config[Key]
            end
        end
    end


    -- SELECTED PET
    if type(Data.SelectedPets) == "table" then

        SelectedPets = {}

        for _, PetName in ipairs(Data.SelectedPets) do

            if type(PetName) == "string" then

                table.insert(
                    SelectedPets,
                    PetName
                )
            end
        end
    end
end


local function SaveConfig()

    if not writefile then
        return
    end


    local Data = {

        Config = Config,

        SelectedPets = SelectedPets
    }


    local Success, Result = pcall(function()

        return HttpService:JSONEncode(Data)

    end)


    if not Success then

        warn(
            "[AUTO HATCH] SAVE JSON ERROR:",
            Result
        )

        return
    end


    pcall(function()

        writefile(
            CONFIG_FILE,
            Result
        )

    end)
end


LoadConfig()


