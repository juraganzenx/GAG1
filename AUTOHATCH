--==================================================
-- TRADE REQUEST
--==================================================

local function StateTradeRequest()

    if TradeRunning then
        return
    end


    TradeRunning =
        true


    SetState(
        "TRADE REQUEST"
    )


    -- STOP ALL STATE
    UnequipAllPets()
    UnequipAllTools()


    task.wait(
        0.25
    )


    if not Running then

        TradeRunning =
            false

        return

    end


    --==================================================
    -- FIND VALID TARGET
    --==================================================

    local Target =
        GetValidTradeTarget()


    if not Target then

        Log(
            "NO VALID TRADE TARGET"
        )


        TradeRunning =
            false

        return

    end


    local TargetPeryton =
        GetTargetPerytonCount(
            Target
        )

    local LocalPeryton =
        GetLocalPerytonCount()


    Log(
        "TRADE TARGET:",
        Target.Name
    )

    Log(
        "TARGET PERYTON:",
        TargetPeryton
    )

    Log(
        "LOCAL PERYTON:",
        LocalPeryton
    )


    --==================================================
    -- FINAL CONDITION
    --==================================================

    if TargetPeryton >= 12
        or LocalPeryton <= 12 then

        TradeRunning =
            false

        return

    end


    --==================================================
    -- EQUIP TRADING TICKET
    --==================================================

    SetState(
        "EQUIP TICKET"
    )


    local Ticket =
        EquipTradingTicket()


    if not Ticket then

        TradeRunning =
            false

        return

    end


    task.wait(
        TRADE_REQUEST_DELAY
    )


    if not Running then

        UnequipAllTools()

        TradeRunning =
            false

        return

    end


    --==================================================
    -- SEND REQUEST
    --==================================================

    SetState(
        "SEND REQUEST"
    )


    SendRequestEvent:FireServer(
        Target
    )


    task.wait(
        1
    )


    if not Running then

        UnequipAllTools()

        TradeRunning =
            false

        return

    end


    --==================================================
    -- GET PERYTON
    --==================================================

    local Perytons =
        GetPerytonFromContainer(
            Backpack,
            TRADE_MAX_PERYTON
        )


    if #Perytons == 0 then

        Log(
            "NO PERYTON"
        )


        UnequipAllTools()

        TradeRunning =
            false

        return

    end


    --==================================================
    -- ADD PERYTON
    --==================================================

    SetState(
        "ADD PERYTON"
    )


    local Added =
        0


    for _, Pet in ipairs(
        Perytons
    ) do

        if not Running then
            break
        end


        AddItemEvent:FireServer(
            "Pet",
            Pet.UUID
        )


        Added +=
            1


        task.wait(
            TRADE_ADD_DELAY
        )


        if Added >=
            TRADE_MAX_PERYTON then

            break

        end

    end


    if Added == 0 then

        UnequipAllTools()

        TradeRunning =
            false

        return

    end


    Log(
        "ADDED PERYTON:",
        Added
    )


    --==================================================
    -- ACCEPT
    --==================================================

    if Running then

        SetState(
            "TRADE ACCEPT"
        )


        AcceptEvent:FireServer()


        task.wait(
            TRADE_ACCEPT_DELAY
        )

    end


    --==================================================
    -- CONFIRM
    --==================================================

    if Running then

        SetState(
            "TRADE CONFIRM"
        )


        ConfirmEvent:FireServer()


        task.wait(
            TRADE_CONFIRM_DELAY
        )

    end


    --==================================================
    -- UNEQUIP ALL TOOLS
    --==================================================

    SetState(
        "TRADE DONE"
    )


    UnequipAllTools()


    task.wait(
        0.5
    )


    TradeRunning =
        false


    SetState(
        "RESUME"
    )

end


