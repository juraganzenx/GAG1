--==================================================
-- PET UTIL
--==================================================

local function IsPet(
    Tool
)

    return Tool:IsA("Tool")
        and Tool:GetAttribute(
            "ItemType"
        ) == "Pet"
end


local function GetUUID(
    Tool
)

    return Tool:GetAttribute(
        "PET_UUID"
    )
end


local function GetKG(
    Tool
)

    local KG =
        string.match(
            Tool.Name,
            "%[([%d%.]+)%s*[Kk][Gg]%]"
        )


    return tonumber(KG) or 0
end


--==================================================
-- GET PETS
--==================================================

local function GetPets(
    SearchName
)

    local Result = {}


    for _, Tool in ipairs(
        Backpack:GetChildren()
    ) do

        if IsPet(Tool) then

            if string.find(
                string.lower(
                    Tool.Name
                ),
                string.lower(
                    SearchName
                ),
                1,
                true
            ) then

                local UUID =
                    GetUUID(Tool)


                if UUID then

                    table.insert(
                        Result,
                        {
                            Tool = Tool,
                            UUID = UUID,
                            Name = Tool.Name,
                            KG = GetKG(Tool)
                        }
                    )
                end
            end
        end
    end


    table.sort(
        Result,
        function(A, B)

            return A.KG > B.KG

        end
    )


    return Result
end


