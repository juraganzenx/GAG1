        return
    end


    if not Running
        or TradeRunning then

        return

    end


    if not WaitAllEggReady() then
        return

    end


    if not Running
        or TradeRunning then

        return

    end


    if not SetKoiBronto() then
        return
    end


    if not Running
        or TradeRunning then

        return

    end


    HatchAll()

