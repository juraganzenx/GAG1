local function SellTargetPets()

    SetState(
        "SELL"
    )


    if #SelectedPets == 0 then

        Log(
            "NO SELECTED SELL PET"
        )

        return

    end


    local SellNames = {}


    for _, PetName in ipairs(
        SelectedPets
    ) do

        SellNames[PetName] =
            true

    end


    local Count =
        0


    for _, Tool in ipairs(
        Backpack:GetChildren()
    ) do

        if not Running
            or TradeRunning then

            return

        end


        if Tool:IsA("Tool") then

            local PetName =
                nil


            for Name in pairs(
                SellNames
            ) do

                if Tool.Name:match(
                    "^"
                    .. Name
                ) then

                    PetName =
                        Name

                    break

                end

            end


            if PetName then

                local KG =
                    tonumber(
                        Tool.Name:match(
                            "%[([%d%.]+)%s*[Kk][Gg]%]"
                        )
                    )


                if KG
                    and KG <
                    Config.SELL_KG_LIMIT then

                    SellRemote:FireServer(
                        Tool,
                        true
                    )


                    Count +=
                        1


                    task.wait(
                        Config.SELL_DELAY
                    )

                end

            end

        end

    end


    Log(
        "SOLD:",
        Count
    )


    task.wait(
        0.5
    )

end


--==================================================
-- PLACE EGGS
--==================================================

local function PlaceEggsUntilTarget()

    local Current =
        GetEggCount()


    if Current >=
        Config.MAX_EGG then

        return true

    end


    SetState(
        "PLACE EGG"
    )


    while Running
        and not TradeRunning
        and Current < Config.MAX_EGG do


        local EggTool =
            EquipEgg()


        if not EggTool then
            return false
        end


        local Batch =
            math.max(
                1,
                math.floor(
                    Config.PLACE_BATCH
                )
            )


        for i = 1, Batch do

            if not Running
                or TradeRunning then

                return false

            end


            local Before =
                GetEggCount()


            if Before >=
                Config.MAX_EGG then

                break

            end


            CreateEgg(
                GetRandomPlantPosition()
            )


            task.wait(
                Config.PLACE_DELAY
            )

        end


        UnequipAllTools()


        task.wait(
            Config.AFTER_PLACE_WAIT
        )


        Current =
            GetEggCount()

    end


    return
        Current >=
        Config.MAX_EGG

end


