local function GetPerytonFromContainer(
    Container,
    MaxCount
)

    local Result = {}


    if not Container then
        return Result
    end


    for _, Tool in ipairs(
        Container:GetChildren()
    ) do

        if Tool:IsA("Tool") then

            local PetName =
                Tool:GetAttribute(
                    "f"
                )

            local UUID =
                Tool:GetAttribute(
                    "PET_UUID"
                )


            if PetName ==
                "Peryton"
                and UUID then

                table.insert(
                    Result,
                    {
                        Tool = Tool,
                        UUID = UUID
                    }
                )


                if MaxCount
                    and #Result >= MaxCount then

                    break

                end

            end

        end

    end


    return Result

end


