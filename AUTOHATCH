    local SellNames = {}


    for _, PetName in ipairs(
        SelectedPets
    ) do

        SellNames[PetName] =
            true

    end


    local Count =
        0


    for _, Tool in ipairs(
        Backpack:GetChildren()
    ) do

        if not Running then
            return
        end


        if Tool:IsA("Tool") then

            local PetName =
                nil


            for Name in pairs(
                SellNames
            ) do

                if Tool.Name:match(
                    "^"
                    .. Name
                ) then

                    PetName =
                        Name

                    break

                end

            end


            if PetName then

                local KG =
                    tonumber(
                        Tool.Name:match(
                            "%[([%d%.]+)%s*[Kk][Gg]%]"
                        )
                    )


                if KG
                    and KG <
                    Config.SELL_KG_LIMIT then

                    SellRemote:FireServer(
                        Tool,
                        true
                    )


                    Count += 1


                    task.wait(
                        Config.SELL_DELAY
                    )

                end

            end

        end

    end


    Log(
        "SOLD:",
        Count
    )


    task.wait(
        0.5
    )

end


--==================================================
-- PLACE EGGS
--==================================================

local function PlaceEggsUntilTarget()

    local Current =
        GetEggCount()


    if Current >=
        Config.MAX_EGG then

        return true

    end


    SetState(
        "PLACE EGG"
    )


    while Running
        and Current <
        Config.MAX_EGG do


        local EggTool =
            EquipEgg()


        if not EggTool then
            return false
        end


        local Batch =
            math.max(
                1,
                math.floor(
                    Config.PLACE_BATCH
                )
            )


        for i = 1, Batch do

            if not Running then
                return false
            end


            local Before =
                GetEggCount()


            if Before >=
                Config.MAX_EGG then

                break

            end


            CreateEgg(
                GetRandomPlantPosition()
            )


            task.wait(
                Config.PLACE_DELAY
            )

        end


        UnequipAllTools()


        task.wait(
            Config.AFTER_PLACE_WAIT
        )


        Current =
            GetEggCount()


    end


    return
        Current >=
        Config.MAX_EGG

end


--==================================================
-- LOW STATE
--==================================================

local function StateLowTarget()

    SetState(
        "LOW TARGET"
    )


    UnequipAllPets()


    if not Running then
        return
    end


    if GetEggCount() <
        Config.MAX_EGG then

        if not PlaceEggsUntilTarget() then
            return
        end

    end


    if not Running then
        return
    end


    if GetEggCount() <
        Config.MAX_EGG then

        return

    end


    if not SetBaldMimic() then
        return
    end


    if not Running then
        return
    end


    if not WaitAllEggReady() then
        return
    end


    if not Running then
        return
    end


    if not SetKoiBronto() then
        return
    end


    if not Running then
        return
    end


    HatchAll()

end


--==================================================
-- HIGH STATE
--==================================================

local function StateHighTarget()

    SetState(
        "HIGH TARGET"
    )


    UnequipAllPets()


    if not Running then
        return
    end


    if not SetSeals() then
        return
    end


    if not Running then
        return
    end


    SellTargetPets()


    while Running do

        local Count =
            GetTargetCount()


        if Count <
            Config.TARGET_LIMIT then

            return

        end


        if not CheckSeals() then

            if not SetSeals() then
                return
            end

        end


        task.wait(
            math.max(
                1,
                Config.LOOP_DELAY
            )
        )

    end

end


--==================================================
-- MAIN LOOP
--==================================================

local MainLoopStarted =
    false


local function StartMainLoop()

    if MainLoopStarted then
        return
    end


    MainLoopStarted =
        true


    task.spawn(function()

        while true do

            if Running then

                UpdateTargetCount()


                local TargetCount =
                    GetTargetCount()


                local EggCount =
                    GetEggCount()


                if TargetCount >=
                    Config.TARGET_LIMIT then

                    StateHighTarget()

                else

                    StateLowTarget()

                end

            else

                SetState(
                    "OFF"
                )


                task.wait(1)

            end

        end

    end)

end


