    nil


local StartPos =
    nil


Header.InputBegan:Connect(function(Input)

    if Input.UserInputType ==
        Enum.UserInputType.MouseButton1 then

        Dragging =
            true


        DragStart =
            Input.Position


        StartPos =
            Main.Position

    end

end)


Header.InputEnded:Connect(function(Input)

    if Input.UserInputType ==
        Enum.UserInputType.MouseButton1 then

        Dragging =
            false

    end

end)


UIS.InputChanged:Connect(function(Input)

    if not Dragging then
        return
    end


    if Input.UserInputType ~=
        Enum.UserInputType.MouseMovement then

        return
    end


    if not DragStart
        or not StartPos then

        return
    end


    local Delta =
        Input.Position
        - DragStart


    Main.Position =
        UDim2.new(

            StartPos.X.Scale,

            StartPos.X.Offset
            + Delta.X,

            StartPos.Y.Scale,

            StartPos.Y.Offset
            + Delta.Y

        )

end)


