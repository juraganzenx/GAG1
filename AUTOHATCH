--==================================================
-- WAIT EGGS
--==================================================

local function WaitAllEggReady()

    SetState(
        "WAIT EGG"
    )


    while Running do

        local Target =
            GetTargetCount()


        if Target >=
            Config.TARGET_LIMIT then

            return false

        end


        local EggCount =
            GetEggCount()


        if EggCount == 0 then
            return false
        end


        if AllEggsReady() then

            return true

        end


        task.wait(
            math.max(
                0.5,
                Config.LOOP_DELAY
            )
        )

    end


    return false

end


