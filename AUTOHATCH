--==================================================
-- PETLIST FROM REPLICATEDSTORAGE
--==================================================

local PetList = {}


local function LoadPetList()

    table.clear(PetList)


    local DataFolder =
        RS:FindFirstChild("Data")

    if not DataFolder then
        return
    end


    local PetRegistry =
        DataFolder:FindFirstChild("PetRegistry")

    if not PetRegistry then
        return
    end


    local PetListModule =
        PetRegistry:FindFirstChild("PetList")

    if not PetListModule then
        return
    end


    local Success, Data =
        pcall(function()

            if PetListModule:IsA("ModuleScript") then

                return require(PetListModule)

            end

            return nil
        end)


    if not Success or type(Data) ~= "table" then

        warn(
            "[AUTO HATCH] GAGAL LOAD PetList"
        )

        return
    end


    for Key, Value in pairs(Data) do

        local PetName


        --==========================================
        -- FORMAT:
        -- ["Pet Name"] = {...}
        --==========================================

        if type(Key) == "string" then

            PetName = Key

        elseif type(Value) == "table" then

            if type(Value.Name) == "string" then

                PetName = Value.Name

            elseif type(Value.PetName) == "string" then

                PetName = Value.PetName
            end
        end


        if PetName
            and PetName ~= "" then

            table.insert(
                PetList,
                PetName
            )
        end
    end


    table.sort(
        PetList,
        function(A, B)

            return string.lower(A)
                < string.lower(B)

        end
    )


    print(
        "[AUTO HATCH] PetList Loaded:",
        #PetList
    )
end


LoadPetList()


