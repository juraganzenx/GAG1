local function GetPetRegistryList()

    local Result = {}


    local Data =
        RS:FindFirstChild(
            "Data"
        )

    if not Data then
        return Result
    end


    local PetRegistry =
        Data:FindFirstChild(
            "PetRegistry"
        )

    if not PetRegistry then
        return Result
    end


    local PetList =
        PetRegistry:FindFirstChild(
            "PetList"
        )

    if not PetList then
        return Result
    end


    if PetList:IsA("ModuleScript") then

        local Success, Module =
            pcall(
                require,
                PetList
            )

        if Success
            and type(Module) == "table" then

            for Name, Value in pairs(
                Module
            ) do

                if type(Name) == "string" then

                    table.insert(
                        Result,
                        Name
                    )

                elseif type(Value) == "string" then

                    table.insert(
                        Result,
                        Value
                    )

                end

            end

        end

    else

        for _, Object in ipairs(
            PetList:GetChildren()
        ) do

            table.insert(
                Result,
                Object.Name
            )

        end

    end


    table.sort(
        Result,
        function(A, B)

            return string.lower(A)
                < string.lower(B)

        end
    )


    return Result

end


