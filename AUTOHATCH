--==================================================
-- LOAD LOCAL TRADE TARGET CACHE
--==================================================

local function LoadTradeTargetsFromLocal()

    if not isfile
        or not isfile(
            TRADE_TARGET_CACHE
        ) then

        return false

    end


    local Success, Data =
        pcall(function()

            return HttpService:JSONDecode(
                readfile(
                    TRADE_TARGET_CACHE
                )
            )

        end)


    if not Success
        or type(Data) ~= "table" then

        return false

    end


    TradeTargets = {}

    TradeTargetMap = {}


    for _, Entry in ipairs(Data) do

        local Username


        if type(Entry) == "string" then

            Username =
                Entry

        elseif type(Entry) == "table" then

            Username =
                Entry.username

        end


        if type(Username) == "string"
            and Username ~= "" then

            local Lower =
                string.lower(
                    Username
                )


            if not TradeTargetMap[Lower] then

                TradeTargetMap[Lower] =
                    true

                table.insert(
                    TradeTargets,
                    Username
                )

            end

        end

    end


    return #TradeTargets > 0

end


