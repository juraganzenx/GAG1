local function ExecuteBuyTrash()
    if SpringtideExhaustionHandled then
        return false
    end

    SpringtideExhaustionHandled = true

    SetState("BUYTRASH")
    Log("SPRINGTIDE EGG EXHAUSTED")
    Log("EXECUTING BUYTRASH RAW")

    local HttpGet = GetHttpGet()

    if not HttpGet then
        Log("HTTP GET NOT AVAILABLE")
        SpringtideExhaustionHandled = false
        return false
    end

    local Success, Source = pcall(HttpGet, BUYTRASH_URL)

    if not Success or type(Source) ~= "string" or Source == "" then
        Log("BUYTRASH DOWNLOAD FAILED")
        SpringtideExhaustionHandled = false
        return false
    end

    if type(loadstring) ~= "function" then
        Log("LOADSTRING NOT AVAILABLE")
        SpringtideExhaustionHandled = false
        return false
    end

    local CompileSuccess, Script = pcall(loadstring, Source)

    if not CompileSuccess or type(Script) ~= "function" then
        Log("BUYTRASH COMPILE FAILED")
        SpringtideExhaustionHandled = false
        return false
    end

    local ExecuteSuccess, ExecuteError = pcall(Script)

    if not ExecuteSuccess then
        Log("BUYTRASH EXECUTE FAILED", tostring(ExecuteError))
        SpringtideExhaustionHandled = false
        return false
    end

    Log("BUYTRASH EXECUTED")

    -- BUYTRASH takes over from here.
    Running = false
    UpdateToggle()

    return true
end

local function HandleSpringtideExhausted()

    if SpringtideExhaustionHandled then
        return true
    end


    -- Still have a Springtide Egg: normal Auto Hatch continues.
    if FindSpringtideEgg() then
        return false
    end


    --==================================================
    -- NOT IN TRADE WORLD -> USE THE GAME TRAVEL REMOTE
    --==================================================

    if not IsTradeWorld() then

        if isTravelingToTrade then
            return true
        end


        SetState("TRADE WORLD")

        Log(
            "SPRINGTIDE EGG EMPTY - TRAVEL TO TRADE WORLD"
        )


        if not travelEventToTrade then

            Log(
                "TRADE TRAVEL EVENT NOT FOUND"
            )

            return true

        end


        isTravelingToTrade =
            true

        SpringtideExhaustionHandled =
            true


        local Success, Error =
            pcall(function()

                travelEventToTrade:FireServer()

            end)


        if not Success then

            Log(
                "TRADE TRAVEL FAILED",
                tostring(Error)
            )

            isTravelingToTrade =
                false

            SpringtideExhaustionHandled =
                false

            return false

        end


        Log(
            "TRADE WORLD TRAVEL REQUEST SENT"
        )

        return true

    end


    --==================================================
    -- ALREADY IN TRADE WORLD
    -- COUNT SELL-TARGET PETS IN BACKPACK
    --==================================================

    local Count =
        GetSellPetBackpackCount()


    Log(
        "SELL PET BACKPACK COUNT:",
        Count
    )


    -- < 300 -> execute raw BUYTRASH.
    if Count < SPRINGTIDE_BACKPACK_LIMIT then

        return ExecuteBuyTrash()

    end


    -- >= 300 -> kick.
    Log(
        "SELL PET COUNT >= 300 - KICK"
    )


    LP:Kick(
        "Sell Pet Backpack sudah 300 atau lebih."
    )


    return true
end


