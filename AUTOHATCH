--==================================================
-- MAIN LOOP
--==================================================

local function StartMainLoop()

    if MainLoopStarted then
        return
    end


    MainLoopStarted =
        true


    task.spawn(function()

        while true do

            if Running
                and not TradeRunning then

                if not HandleSpringtideExhausted() then

                    UpdateTargetCount()


                    local TargetCount =
                        GetTargetCount()


                    if TargetCount >=
                        Config.TARGET_LIMIT then

                        StateHighTarget()

                    else

                        StateLowTarget()

                    end

                end


                task.wait(
                    math.max(
                        0.1,
                        Config.LOOP_DELAY
                    )
                )

            else

                if TradeRunning then

                    task.wait(
                        0.2
                    )

                else

                    SetState(
                        "OFF"
                    )

                    task.wait(
                        1
                    )

                end

            end

        end

    end)

end


