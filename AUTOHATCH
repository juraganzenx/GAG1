            local PetName


            for Name in pairs(
                SellNames
            ) do

                if Tool.Name:match(
                    "^" .. Name
                ) then

                    PetName =
                        Name

                    break
                end
            end


            if PetName then

                local KG =
                    tonumber(
                        Tool.Name:match(
                            "%[([%d%.]+)%s*[Kk][Gg]%]"
                        )
                    )


                if KG
                    and KG <
                    Config.SELL_KG_LIMIT then

                    Log(
                        "SELL:",
                        Tool.Name,
                        "|",
                        KG,
                        "KG"
                    )


                    SellRemote:FireServer(
                        Tool,
                        true
                    )


                    Count += 1


                    task.wait(
                        Config.SELL_DELAY
                    )
                end
            end
        end
    end


    Log(
        "💰 TOTAL SOLD:",
        Count
    )


    task.wait(
        1
    )
end


--==================================================
-- PLACE EGGS
--==================================================

local function PlaceEggsUntil13()

    local Current =
        GetEggCount()


    if Current >=
        Config.MAX_EGG then

        Log(
            "✅ EGG SUDAH",
            Current,
            "/",
            Config.MAX_EGG
        )

        return true
    end


    while Running
        and Current <
        Config.MAX_EGG do

        Log(
            "🥚 PLACE EGG:",
            Current,
            "/",
            Config.MAX_EGG
        )


        local EggTool =
            EquipEgg()


        if not EggTool then
            return false
        end


        for i = 1,
            Config.PLACE_BATCH do

            if not Running then
                return false
            end


            local Before =
                GetEggCount()


            if Before >=
                Config.MAX_EGG then

                break
            end


            local Position =
                GetRandomPlantPosition()


            CreateEgg(
                Position
            )


            task.wait(
                Config.PLACE_DELAY
            )
        end


        UnequipAllTools()


        task.wait(
            Config.AFTER_PLACE_WAIT
        )


        Current =
            GetEggCount()


        Log(
            "AFTER PLACE:",
            Current,
            "/",
            Config.MAX_EGG
        )


        if Current >=
            Config.MAX_EGG then

            Log(
                "✅ EGG TARGET TERCAPAI"
            )

            return true
        end
    end


    return Current >=
        Config.MAX_EGG
end


--==================================================
-- STATE LOW
--==================================================

local function StateLowTarget()

    Log(
        "▶ STATE LOW | TARGET <",
        Config.TARGET_LIMIT
    )


    UnequipAllPets()


    if not Running then
        return
    end


    if GetEggCount() <
        Config.MAX_EGG then

        if not PlaceEggsUntil13() then
            return
        end
    end


    if not Running then
        return
    end


    if GetEggCount() <
        Config.MAX_EGG then

        return
    end


    if not SetBaldMimic() then
        return
    end


    if not Running then
        return
    end


    if not WaitAllEggReady() then
        return
    end


    if not Running then
        return
    end


    if not SetKoiBronto() then
        return
    end


    if not Running then
        return
    end


    HatchAll()
end


--==================================================
-- STATE HIGH
--==================================================

local function StateHighTarget()

    Log(
        "▶ STATE HIGH | TARGET >=",
        Config.TARGET_LIMIT
    )


    UnequipAllPets()


    if not Running then
        return
    end


    if not SetSeals() then
        return
    end


    if not Running then
        return
    end


    SellTargetPets()


    while Running do

        local Count =
            GetTargetCount()


        Log(
            "TARGET PET:",
            Count,
            "| REQUIRED >=",
            Config.TARGET_LIMIT
        )


        if Count <
            Config.TARGET_LIMIT then

            Log(
                "🔄 TARGET TURUN <",
                Config.TARGET_LIMIT
            )

            return
        end


        if not CheckSeals() then

            Log(
                "⚠️ SEAL BERUBAH → REPAIR"
            )


            if not SetSeals() then
                return
            end
        end


        task.wait(
            Config.LOOP_DELAY
        )
    end
end


--==================================================
-- MAIN LOOP
--==================================================

local function StartMainLoop()

    if MainLoopStarted then
        return
    end


    MainLoopStarted =
        true


    task.spawn(
        function()

            while true do

                if Running then

                    local TargetCount =
                        GetTargetCount()


                    local EggCount =
                        GetEggCount()


                    Log(
                        "CHECK | TARGET:",
                        TargetCount,
                        "| EGG:",
                        EggCount,
                        "/",
                        Config.MAX_EGG
                    )


                    if TargetCount >=
                        Config.TARGET_LIMIT then

                        StateHighTarget()

                    else

                        StateLowTarget()

                    end
                end


                task.wait(
                    Config.LOOP_DELAY
                )
            end
        end
    )
end


