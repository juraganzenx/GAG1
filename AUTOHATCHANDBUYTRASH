        return "TRADE WORLD"

    end


    return "UNKNOWN"

end


--========================================================
-- EXECUTE SCRIPT
--========================================================

local function ExecuteScript(
    URL
)

    local Success, Result =
        pcall(function()

            local Source =
                game:HttpGet(
                    URL,
                    true
                )

            local Func =
                loadstring(
                    Source
                )

            if not Func then

                error(
                    "loadstring failed"
                )

            end

            return Func()

        end)


    if not Success then

        warn(
            "[EXECUTE ERROR]",
            tostring(Result)
        )

        return false

    end


    return true

end


--========================================================
-- COUNT SPRINGTIDE EGG
--========================================================

local function CountSpringtideEgg()

    local Count =
        0


    --====================================================
    -- BACKPACK
    --====================================================

    local Backpack =
        LocalPlayer:FindFirstChild(
            "Backpack"
        )


    if Backpack then

        for _, Tool in ipairs(
            Backpack:GetChildren()
        ) do

            if Tool:IsA("Tool")
            and Tool:GetAttribute("h")
                == "Springtide Egg" then

                Count += 1

            end

        end

    end


    --====================================================
    -- CHARACTER
    --====================================================

    local Character =
        LocalPlayer.Character


    if Character then

        for _, Tool in ipairs(
            Character:GetChildren()
        ) do

            if Tool:IsA("Tool")
            and Tool:GetAttribute("h")
                == "Springtide Egg" then

                Count += 1

            end

        end

    end


    return Count

end


--========================================================
-- TARGET PETS
--========================================================

local TARGET_PETS = {

    Springbee = true,

    Jerboa = true,

    Nyala = true,

}


--========================================================
-- GET PET TYPE
--========================================================

local function GetPetType(
    Tool
)

    if not Tool:IsA("Tool") then

        return nil

    end


    for PetName in pairs(
        TARGET_PETS
    ) do

        if string.match(
            Tool.Name,
            "^" .. PetName .. " "
        ) then

            return PetName

        end

    end


    return nil

end


--========================================================
-- COUNT TARGET PETS
--========================================================

local function CountTargetPets()

    local Counts = {

        Springbee = 0,

        Jerboa = 0,

        Nyala = 0,

    }


    --====================================================
    -- BACKPACK
    --====================================================

    local Backpack =
        LocalPlayer:FindFirstChild(
            "Backpack"
        )


    if Backpack then

        for _, Tool in ipairs(
            Backpack:GetChildren()
        ) do

            local PetType =
                GetPetType(
                    Tool
                )


            if PetType then

                Counts[PetType] += 1

            end

        end

    end


    --====================================================
    -- CHARACTER
    --====================================================

    local Character =
        LocalPlayer.Character


    if Character then

        for _, Tool in ipairs(
            Character:GetChildren()
        ) do

            local PetType =
                GetPetType(
                    Tool
                )


            if PetType then

                Counts[PetType] += 1

            end

        end

    end


    Counts.Total =
        Counts.Springbee
        + Counts.Jerboa
        + Counts.Nyala


    return Counts

end


--========================================================
-- TRAVEL TO TRADE WORLD
--========================================================
--
-- IMPORTANT:
--
-- FireServer berhasil:
--     Traveling = true
--
-- Selama masih Main World:
--     tetap TRAVELING TO TRADE
--
-- Tidak ada timeout.
-- Tidak ada TRAVEL FAILED.
--
-- Hanya FireServer error yang dianggap error.
--========================================================

local function TravelToTradeWorld()

    --====================================================
    -- ALREADY TRADE WORLD
    --====================================================

    if game.PlaceId == TRADE_WORLD then

        Traveling = false
        TravelRequestSent = false

        return true

    end


    --====================================================
    -- ALREADY TRAVELING
    --====================================================

    if Traveling then

        return true

    end


    --====================================================
    -- ONLY MAIN WORLD
    --====================================================

    if game.PlaceId ~= MAIN_WORLD then

        return false

    end


    --====================================================
    -- LOCK
    --====================================================

    Traveling = true


    TravelRequestSent = false


    SetStatus(
        "MAIN WORLD",
        CountSpringtideEgg(),
        "TRAVELING TO TRADE"
    )


    warn(
        "========================================"
    )

    warn(
        "[TRAVEL] MAIN WORLD"
    )

    warn(
        "[TRAVEL] Sending TravelToTradeWorld"
    )

    warn(
        "[TRAVEL] Remote:",
        TravelRemote:GetFullName()
    )

    warn(
        "========================================"
    )


    --====================================================
    -- FIRE REMOTE
    --====================================================

    local Success, ErrorMessage =
        pcall(function()

            TravelRemote:FireServer()

        end)


    --====================================================
    -- REMOTE ERROR
    --====================================================

    if not Success then

        warn(
            "[TRAVEL] FireServer ERROR:",
            tostring(ErrorMessage)
        )


        Traveling = false

        TravelRequestSent = false


        SetStatus(
            "MAIN WORLD",
            CountSpringtideEgg(),
            "TRAVEL ERROR"
        )


        return false

    end


    --====================================================
    -- REQUEST SENT
    --====================================================

    TravelRequestSent = true


    warn(
        "[TRAVEL] Request sent."
    )

    warn(
        "[TRAVEL] Waiting for PlaceId..."
    )


    SetStatus(
        "MAIN WORLD",
        CountSpringtideEgg(),
        "TRAVELING TO TRADE"
    )


    --====================================================
    -- MONITOR THREAD
    --====================================================

    task.spawn(function()

        while Traveling do

            task.wait(1)


            local PlaceId =
                game.PlaceId


            --============================================
            -- ARRIVED
            --============================================

            if PlaceId == TRADE_WORLD then

                Traveling = false

                TravelRequestSent = false


                SetStatus(
                    "TRADE WORLD",
                    CountTargetPets().Total,
                    "ARRIVED"
                )


                warn(
                    "========================================"
                )

                warn(
                    "[TRAVEL] ARRIVED IN TRADE WORLD"
                )

                warn(
                    "[TRAVEL] PlaceId:",
                    PlaceId
                )

                warn(
                    "========================================"
                )


                break

            end


            --============================================
            -- STILL MAIN WORLD
            --============================================

            if PlaceId == MAIN_WORLD then

                SetStatus(
                    "MAIN WORLD",
                    CountSpringtideEgg(),
                    "TRAVELING TO TRADE"
                )

            end

        end

    end)


    return true

end


--========================================================
-- MAIN WORLD CHECK
--========================================================

local function CheckMainWorld()

    --====================================================
    -- DO NOT TOUCH ROUTER DURING TRAVEL
    --====================================================

    if Traveling then

        SetStatus(
            "MAIN WORLD",
            CountSpringtideEgg(),
            "TRAVELING TO TRADE"
        )

        return

    end


    --====================================================
    -- COUNT EGG
    --====================================================

    local EggCount =
        CountSpringtideEgg()


    warn(
        "[MAIN WORLD] Springtide Egg:",
        EggCount
    )


    --====================================================
    -- EGG EMPTY
    --====================================================

    if EggCount <= 0 then

        SetStatus(
            "MAIN WORLD",
            EggCount,
            "TRAVELING TO TRADE"
        )


        TravelToTradeWorld()


        return

    end


    --====================================================
    -- EGG AVAILABLE
    --====================================================

    SetStatus(
        "MAIN WORLD",
        EggCount,
        "AUTOHATCH"
    )


    --====================================================
    -- START AUTOHATCH
    --====================================================

    if not AutoHatchStarted then

        AutoHatchStarted =
            true


        warn(
            "========================================"
        )

        warn(
            "[AUTOHATCH] Springtide Egg > 0"
        )

        warn(
            "[AUTOHATCH] Starting..."
        )

        warn(
            "========================================"
        )


        task.spawn(function()

            local Success =
                ExecuteScript(
                    AUTOHATCH_URL
                )


            if Success then

                warn(
                    "[AUTOHATCH] Executed."
                )

            else

                warn(
                    "[AUTOHATCH] Execute failed."
                )

            end

        end)

    end

end


--========================================================
-- TRADE WORLD CHECK
--========================================================

local function CheckTradeWorld()

    --====================================================
    -- COUNT PETS
    --====================================================

    local Counts =
        CountTargetPets()


    local Total =
        Counts.Total


    warn(
        "========================================"
    )

    warn(
        "[TRADE WORLD]"
    )

    warn(
        "Springbee:",
        Counts.Springbee
    )

    warn(
        "Jerboa:",
        Counts.Jerboa
    )

    warn(
        "Nyala:",
        Counts.Nyala
    )

    warn(
        "TOTAL:",
        Total
    )

    warn(
        "========================================"
    )


    --====================================================
    -- 300 OR MORE
    --====================================================

    if Total >= 300 then

        SetStatus(
            "TRADE WORLD",
            Total .. " / 300",
            "KICK - 300 REACHED"
        )


        warn(
            "[TRADE] Target total >= 300"
        )

        warn(
            "[TRADE] Kicking player."
        )


        task.wait(1)


        LocalPlayer:Kick(
            "Springbee + Jerboa + Nyala reached 300."
        )


        return

    end


    --====================================================
    -- BELOW 300
    --====================================================

    SetStatus(
        "TRADE WORLD",
        Total .. " / 300",
        "BUYTRASH"
    )


    --====================================================
    -- START BUYTRASH
    --====================================================

    if not BuyTrashStarted then

        BuyTrashStarted =
            true


        warn(
            "========================================"
        )

        warn(
            "[BUYTRASH] Target total < 300"
        )

        warn(
            "[BUYTRASH] Starting..."
        )

        warn(
            "========================================"
        )


        task.spawn(function()

            local Success =
                ExecuteScript(
                    BUYTRASH_URL
                )


            if Success then

                warn(
                    "[BUYTRASH] Executed."
                )

            else

                warn(
                    "[BUYTRASH] Execute failed."
                )

            end

        end)

    end

end


--========================================================
-- START
--========================================================

task.wait(3)


--========================================================
-- INITIAL WORLD CHECK
--========================================================

if game.PlaceId == MAIN_WORLD then

    CheckMainWorld()


elseif game.PlaceId == TRADE_WORLD then

    CheckTradeWorld()


else

    SetStatus(
        "UNKNOWN",
        "--",
        "UNKNOWN PLACE"
    )


    warn(
        "[WORLD ROUTER] Unknown PlaceId:",
        game.PlaceId
    )

end


--========================================================
-- MAIN ROUTER LOOP
--========================================================

while task.wait(
    CHECK_INTERVAL
) do

    local PlaceId =
        game.PlaceId


    --====================================================
    -- TRADE WORLD HAS PRIORITY
    --====================================================

    if PlaceId == TRADE_WORLD then

        -- Kalau sebelumnya sedang travel,
        -- tandai sudah selesai.

        if Traveling then

            Traveling = false

            TravelRequestSent = false

        end


        SetNextCheck(
            CHECK_INTERVAL
        )


        CheckTradeWorld()


    --====================================================
    -- TRAVELING
    --====================================================
    --
    -- Ini penting:
    --
    -- Jangan jalankan CheckMainWorld().
    -- Jangan kirim TravelRemote lagi.
    -- Jangan reset Traveling.
    --
    -- Biarkan monitor travel yang menangani.
    --====================================================

    elseif Traveling then

        SetNextCheck(
            "--"
        )


        SetStatus(
            "MAIN WORLD",
            CountSpringtideEgg(),
            "TRAVELING TO TRADE"
        )


    --====================================================
    -- MAIN WORLD
    --====================================================

    elseif PlaceId == MAIN_WORLD then

        SetNextCheck(
            CHECK_INTERVAL
        )


        CheckMainWorld()


    --====================================================
    -- UNKNOWN
    --====================================================

    else

        SetStatus(
            "UNKNOWN",
            "--",
            "UNKNOWN PLACE"
        )


        warn(
            "[WORLD ROUTER] Unknown PlaceId:",
            PlaceId
        )

    end

end
