--========================================================
-- WORLD ROUTER + CONFIG FROM GITHUB
--========================================================
-- CONFIG:
-- https://raw.githubusercontent.com/juraganzenx/Config/refs/heads/main/AUTOHATCHANDMARKET.json
--
-- MAIN:
--   HatchEgg > 0 OR SellPets total > 0 -> AUTOHATCH
--   HatchEgg = 0 AND SellPets total = 0 -> TRAVEL
--
-- TRADE:
--   SellPets total < 300 -> BUYTRASH
--   SellPets total >= 300 -> KICK
--
-- Travel:
--   GameEvents.TradeWorld.TravelToTradeWorld:FireServer()
--   No TeleportService
--   No TRAVEL FAILED while still in Main World
--========================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CoreGui = game:GetService("CoreGui")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer

local MAIN_WORLD = 126884695634066
local TRADE_WORLD = 129954712878723

local CHECK_INTERVAL = 10
local TRADE_TARGET = 300

local CONFIG_URL = "https://raw.githubusercontent.com/juraganzenx/Config/refs/heads/main/AUTOHATCHANDMARKET.json"
local AUTOHATCH_URL = "https://raw.githubusercontent.com/juraganzenx/GAG1/refs/heads/main/AUTOHATCH"
local BUYTRASH_URL = "https://raw.githubusercontent.com/juraganzenx/GAG1/refs/heads/main/BUYTRASH"

local AutoHatchStarted = false
local BuyTrashStarted = false
local Traveling = false

local Config = nil
local ConfigLoaded = false

local GameEvents = ReplicatedStorage:WaitForChild("GameEvents")
local TravelRemote = GameEvents:WaitForChild("TradeWorld"):WaitForChild("TravelToTradeWorld")

--========================================================
-- GUI CLEANUP
