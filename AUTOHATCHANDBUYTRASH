local CountLabel = CreateLabel("Count", 71, "Count: --", 13, false)
local StateLabel = CreateLabel("State", 94, "State: Starting...", 13, true)
local CheckLabel = CreateLabel("Check", 118, "Next check: --", 11, false)

local function SetStatus(world, count, state)
    WorldLabel.Text = "World: " .. tostring(world)
    CountLabel.Text = "Count: " .. tostring(count)
    StateLabel.Text = "State: " .. tostring(state)
end

local function SetNextCheck(value)
    CheckLabel.Text = "Next check: " .. tostring(value) .. "s"
end

local function SetConfigStatus(value)
    ConfigLabel.Text = "Config: " .. tostring(value)
end

--========================================================
-- LOAD CONFIG
--========================================================

local function LoadConfig()
    local success, result = pcall(function()
        local source = game:HttpGet(CONFIG_URL, true)

        if not source or source == "" then
            error("Config HTTP response empty")
        end

        local data = HttpService:JSONDecode(source)

        if type(data) ~= "table" then
            error("Config JSON is not a table")
        end

        if type(data.HatchEgg) ~= "string" or data.HatchEgg == "" then
            error("HatchEgg missing or invalid")
        end

        if type(data.SellPets) ~= "table" then
            error("SellPets missing or invalid")
        end

        return data
    end)

    if not success then
        Config = nil
        ConfigLoaded = false
        SetConfigStatus("LOAD ERROR")
        warn("[CONFIG] Load failed:", tostring(result))
        return false
    end

    Config = result
    ConfigLoaded = true

    SetConfigStatus(
        tostring(Config.HatchEgg)
        .. " | Pets: "
        .. tostring(#Config.SellPets)
    )

    warn("========================================")
    warn("[CONFIG] Loaded successfully")
    warn("[CONFIG] HatchEgg:", Config.HatchEgg)

    for _, petName in ipairs(Config.SellPets) do
        warn("[CONFIG] SellPet:", tostring(petName))
    end

    warn("[CONFIG] SellKG:", tostring(Config.SellKG))
    warn("========================================")

    return true
end

--========================================================
-- TOOL MATCH
--========================================================

local function ToolMatches(tool, targetName)
    if not tool or not tool:IsA("Tool") then
        return false
    end

    if type(targetName) ~= "string" or targetName == "" then
        return false
    end

    if tool.Name == targetName then
        return true
    end

    return string.sub(tool.Name, 1, #targetName + 1) == targetName .. " "
end

--========================================================
-- COUNT CONFIGURED EGG
--========================================================

local function CountHatchEgg()
    if not ConfigLoaded or not Config then
        return 0
    end

    local targetEgg = Config.HatchEgg
    local count = 0

    local function scan(container)
        if not container then
            return
        end

        for _, tool in ipairs(container:GetChildren()) do
            if ToolMatches(tool, targetEgg) then
                count += 1
            end
        end
    end

    scan(LocalPlayer:FindFirstChild("Backpack"))
    scan(LocalPlayer.Character)

    return count
end

--========================================================
-- GET CONFIGURED PET TYPE
--========================================================

local function GetPetType(tool)
    if not ConfigLoaded or not Config then
        return nil
    end

    if not tool or not tool:IsA("Tool") then
        return nil
    end

    for _, petName in ipairs(Config.SellPets) do
        if type(petName) == "string" and ToolMatches(tool, petName) then
            return petName
        end
    end

    return nil
end

--========================================================
-- COUNT ALL CONFIGURED PETS
--========================================================

local function CountTargetPets()
    local counts = {}
    local total = 0

    if not ConfigLoaded or not Config then
        counts.Total = 0
        return counts
    end

    for _, petName in ipairs(Config.SellPets) do
        if type(petName) == "string" then
            counts[petName] = 0
        end
    end

    local function scan(container)
        if not container then
            return
        end

        for _, tool in ipairs(container:GetChildren()) do
            local petType = GetPetType(tool)

            if petType then
                counts[petType] = (counts[petType] or 0) + 1
                total += 1
            end
        end
    end

    scan(LocalPlayer:FindFirstChild("Backpack"))
    scan(LocalPlayer.Character)

    counts.Total = total
    return counts
end

--========================================================
-- FORMAT PET COUNTS
--========================================================

local function FormatPetCounts(counts)
    if not ConfigLoaded or not Config then
        return "0"
    end

    local parts = {}

    for _, petName in ipairs(Config.SellPets) do
        if type(petName) == "string" then
            table.insert(
                parts,
                petName .. ": " .. tostring(counts[petName] or 0)
            )
        end
    end

    return table.concat(parts, " | ")
end

--========================================================
-- EXECUTE RAW SCRIPT
--========================================================

local function ExecuteScript(url)
    local success, result = pcall(function()
        local source = game:HttpGet(url, true)

        if not source or source == "" then
            error("HTTP response empty")
        end

        local func = loadstring(source)

        if not func then
            error("loadstring failed")
        end

        return func()
    end)

    if not success then
        warn("[EXECUTE ERROR]", tostring(result))
        return false
    end

    return true
end

--========================================================
-- TRAVEL TO TRADE WORLD
--========================================================
-- Travel condition:
--   configured Egg == 0
--   AND configured SellPets total == 0
--
-- Once FireServer succeeds:
--   Traveling remains true until PlaceId becomes TRADE_WORLD.
--
-- No timeout.
-- No TRAVEL FAILED because PlaceId is still MAIN_WORLD.
--========================================================

local function TravelToTradeWorld()
    if game.PlaceId == TRADE_WORLD then
        Traveling = false
        return true
    end

    if Traveling then
        return true
    end

    if game.PlaceId ~= MAIN_WORLD then
        return false
    end

    local eggCount = CountHatchEgg()
    local petTotal = CountTargetPets().Total

    Traveling = true

    SetStatus(
        "MAIN WORLD",
        "Egg: " .. eggCount .. " | Pets: " .. petTotal,
        "TRAVELING TO TRADE"
    )

    warn("========================================")
    warn("[TRAVEL] MAIN WORLD")
    warn("[TRAVEL] Egg:", eggCount)
    warn("[TRAVEL] Pets:", petTotal)
    warn("[TRAVEL] Sending TravelToTradeWorld")
    warn("[TRAVEL] Remote:", TravelRemote:GetFullName())
    warn("========================================")

    local success, errorMessage = pcall(function()
        TravelRemote:FireServer()
    end)

    if not success then
        Traveling = false

        SetStatus(
            "MAIN WORLD",
            "Egg: " .. CountHatchEgg()
                .. " | Pets: " .. CountTargetPets().Total,
            "TRAVEL ERROR"
        )

        warn("[TRAVEL] FireServer ERROR:", tostring(errorMessage))
        return false
    end

    warn("[TRAVEL] Request sent.")
    warn("[TRAVEL] Waiting for PlaceId...")

    task.spawn(function()
        while Traveling do
            task.wait(1)

            if game.PlaceId == TRADE_WORLD then
                Traveling = false

                local petsNow = CountTargetPets().Total

                SetStatus(
                    "TRADE WORLD",
                    petsNow .. " / " .. TRADE_TARGET,
                    "ARRIVED"
                )

                warn("[TRAVEL] ARRIVED IN TRADE WORLD")
                break
            end

            if game.PlaceId == MAIN_WORLD then
                SetStatus(
                    "MAIN WORLD",
                    "Egg: " .. CountHatchEgg()
                        .. " | Pets: " .. CountTargetPets().Total,
                    "TRAVELING TO TRADE"
                )
            end
        end
    end)

    return true
end

--========================================================
-- MAIN WORLD CHECK
--========================================================

local function CheckMainWorld()
    if Traveling then
        SetStatus(
            "MAIN WORLD",
            "Egg: " .. CountHatchEgg()
                .. " | Pets: " .. CountTargetPets().Total,
            "TRAVELING TO TRADE"
        )
        return
    end

    local eggCount = CountHatchEgg()
    local petCounts = CountTargetPets()
    local petTotal = petCounts.Total

    warn("========================================")
    warn("[MAIN WORLD]")
    warn("[MAIN WORLD] HatchEgg:", tostring(Config and Config.HatchEgg))
    warn("[MAIN WORLD] Egg count:", eggCount)
    warn("[MAIN WORLD] Pet total:", petTotal)
    warn("[MAIN WORLD] Pet detail:", FormatPetCounts(petCounts))
    warn("========================================")

    -- BOTH EMPTY -> TRAVEL
    if eggCount <= 0 and petTotal <= 0 then
        SetStatus(
            "MAIN WORLD",
            "Egg: 0 | Pets: 0",
            "TRAVELING TO TRADE"
        )

        TravelToTradeWorld()
        return
    end

    -- EGG OR PET EXISTS -> AUTOHATCH
    SetStatus(
        "MAIN WORLD",
        "Egg: " .. eggCount .. " | Pets: " .. petTotal,
        "AUTOHATCH"
    )

    if not AutoHatchStarted then
        AutoHatchStarted = true

        warn("[AUTOHATCH] Configured item detected.")
        warn("[AUTOHATCH] Starting...")

        task.spawn(function()
            if ExecuteScript(AUTOHATCH_URL) then
                warn("[AUTOHATCH] Executed.")
            else
                warn("[AUTOHATCH] Execute failed.")
            end
        end)
    end
end

--========================================================
-- TRADE WORLD CHECK
--========================================================

local function CheckTradeWorld()
    local counts = CountTargetPets()
    local total = counts.Total

    warn("========================================")
    warn("[TRADE WORLD]")
    warn("[TRADE WORLD] Pets:", FormatPetCounts(counts))
    warn("[TRADE WORLD] TOTAL:", total)
    warn("========================================")

    if total >= TRADE_TARGET then
        SetStatus(
            "TRADE WORLD",
            total .. " / " .. TRADE_TARGET,
            "KICK - 300 REACHED"
        )

        task.wait(1)

        LocalPlayer:Kick(
            "Configured SellPets reached " .. TRADE_TARGET .. "."
        )

        return
    end

    SetStatus(
        "TRADE WORLD",
        total .. " / " .. TRADE_TARGET,
        "BUYTRASH"
    )

    if not BuyTrashStarted then
        BuyTrashStarted = true

        warn("[BUYTRASH] Configured SellPets total < 300.")
        warn("[BUYTRASH] Starting...")

        task.spawn(function()
            if ExecuteScript(BUYTRASH_URL) then
                warn("[BUYTRASH] Executed.")
            else
                warn("[BUYTRASH] Execute failed.")
            end
        end)
    end
end

--========================================================
-- STARTUP
--========================================================

task.wait(1)

if LoadConfig() then
    if game.PlaceId == MAIN_WORLD then
        CheckMainWorld()
    elseif game.PlaceId == TRADE_WORLD then
        CheckTradeWorld()
    else
        SetStatus("UNKNOWN", "--", "UNKNOWN PLACE")
    end
else
    SetStatus("UNKNOWN", "--", "CONFIG LOAD ERROR")
end

--========================================================
-- MAIN ROUTER LOOP
--========================================================

while task.wait(CHECK_INTERVAL) do
    local placeId = game.PlaceId

    if placeId == TRADE_WORLD then
        Traveling = false

        SetNextCheck(CHECK_INTERVAL)

        -- Refresh config every cycle
        LoadConfig()
        CheckTradeWorld()

    elseif Traveling then
        -- IMPORTANT:
        -- Do not call CheckMainWorld while traveling.
        SetNextCheck("--")

        SetStatus(
            "MAIN WORLD",
            "Egg: " .. CountHatchEgg()
                .. " | Pets: " .. CountTargetPets().Total,
            "TRAVELING TO TRADE"
        )

    elseif placeId == MAIN_WORLD then
        SetNextCheck(CHECK_INTERVAL)

        -- Refresh config every cycle
        LoadConfig()
        CheckMainWorld()

    else
        SetNextCheck("--")
        SetStatus("UNKNOWN", "--", "UNKNOWN PLACE")

        warn("[WORLD ROUTER] Unknown PlaceId:", placeId)
    end
end
