--========================================================
-- INITIAL CHECK
--========================================================

if game.PlaceId == MAIN_WORLD then

    CheckMainWorld()

elseif game.PlaceId == TRADE_WORLD then

    CheckTradeWorld()

else

    SetStatus(
        "UNKNOWN",
        "--",
        "UNKNOWN PLACE"
    )

    warn(
        "[WORLD ROUTER] Unknown PlaceId:",
        game.PlaceId
    )

end


--========================================================
-- 10 SECOND LOOP
--========================================================

while task.wait(CHECK_INTERVAL) do

    local PlaceId = game.PlaceId


    --====================================================
    -- MAIN WORLD
    --====================================================

    if PlaceId == MAIN_WORLD then

        CheckMainWorld()


    --====================================================
    -- TRADE WORLD
    --====================================================

    elseif PlaceId == TRADE_WORLD then

        CheckTradeWorld()


    --====================================================
    -- UNKNOWN
    --====================================================

    else

        SetStatus(
            "UNKNOWN",
            "--",
            "UNKNOWN PLACE"
        )

        warn(
            "[WORLD ROUTER] Unknown PlaceId:",
            PlaceId
        )

    end

end
