--========================================================
-- EXECUTE REMOTE SCRIPT
--========================================================

local function ExecuteScript(URL)

    local Success, Result = pcall(function()

        local Source = game:HttpGet(URL, true)

        local Func = loadstring(Source)

        if not Func then
            error("loadstring failed")
        end

        return Func()

    end)

    if not Success then

        warn("EXECUTE ERROR:", Result)

        return false
    end

    return true
end


--========================================================
-- COUNT SPRINGTIDE EGG
--========================================================

local function CountSpringtideEgg()

    local Count = 0

    -- Backpack
    local Backpack = LocalPlayer:FindFirstChild("Backpack")

    if Backpack then

        for _, Tool in ipairs(Backpack:GetChildren()) do

            if Tool:IsA("Tool")
                and Tool:GetAttribute("h") == "Springtide Egg" then

                Count += 1
            end

        end
    end


    -- Character
    local Character = LocalPlayer.Character

    if Character then

        for _, Tool in ipairs(Character:GetChildren()) do

            if Tool:IsA("Tool")
                and Tool:GetAttribute("h") == "Springtide Egg" then

                Count += 1
            end

        end
    end

    return Count
end


--========================================================
-- TARGET PETS
--========================================================

local TARGET_PETS = {
    Springbee = true,
    Jerboa = true,
    Nyala = true,
}


--========================================================
-- DETECT TARGET PET
--========================================================

local function GetPetType(Tool)

    if not Tool:IsA("Tool") then
        return nil
    end

    for PetName in pairs(TARGET_PETS) do

        -- Contoh:
        -- Jerboa [1.83 KG] [Age 1]
        -- Springbee [2.20 KG] [Age 3]
        -- Nyala [1.50 KG] [Age 1]

        if string.match(
            Tool.Name,
            "^" .. PetName .. " "
        ) then

            return PetName
        end

    end

    return nil
end


--========================================================
-- COUNT TARGET PETS
--========================================================

local function CountTargetPets()

    local Counts = {
        Springbee = 0,
        Jerboa = 0,
        Nyala = 0,
    }

    -- Backpack
    local Backpack = LocalPlayer:FindFirstChild("Backpack")

    if Backpack then

        for _, Tool in ipairs(Backpack:GetChildren()) do

            local PetType = GetPetType(Tool)

            if PetType then
                Counts[PetType] += 1
            end

        end
    end


    -- Character
    local Character = LocalPlayer.Character

    if Character then

        for _, Tool in ipairs(Character:GetChildren()) do

            local PetType = GetPetType(Tool)

            if PetType then
                Counts[PetType] += 1
            end

        end
    end


    Counts.Total =
        Counts.Springbee
        + Counts.Jerboa
        + Counts.Nyala

    return Counts
end


--========================================================
-- TRAVEL TO TRADE WORLD
--========================================================

local function TravelToTradeWorld()

    if Traveling then
        return
    end

    Traveling = true

    SetStatus(
        "MAIN WORLD",
        CountSpringtideEgg(),
        "TRAVELING TO TRADE"
    )

    warn("================================")
    warn("SPRINGTIDE EGG = 0")
    warn("TRAVEL TO TRADE WORLD")
    warn("================================")

    TeleportService:Teleport(
        TRADE_WORLD,
        LocalPlayer
    )
end


--========================================================
-- MAIN WORLD
--========================================================

local function CheckMainWorld()

    local EggCount = CountSpringtideEgg()

    warn(
        "[MAIN WORLD] Springtide Egg:",
        EggCount
    )


    --====================================================
    -- EGG HABIS
    --====================================================

    if EggCount <= 0 then

        SetStatus(
            "MAIN WORLD",
            EggCount,
            "TRAVELING TO TRADE"
        )

        TravelToTradeWorld()

        return
    end


    --====================================================
    -- EGG MASIH ADA
    --====================================================

    SetStatus(
        "MAIN WORLD",
        EggCount,
        "AUTOHATCH"
    )


    if not AutoHatchStarted then

        AutoHatchStarted = true

        warn("SPRINGTIDE EGG > 0")
        warn("START AUTOHATCH")

        task.spawn(function()

            ExecuteScript(
                AUTOHATCH_URL
            )

        end)

    end
end


--========================================================
-- TRADE WORLD
--========================================================

local function CheckTradeWorld()

    local Counts = CountTargetPets()

    local Total = Counts.Total

    warn("================================")
    warn("TRADE WORLD")
    warn("Springbee:", Counts.Springbee)
    warn("Jerboa:", Counts.Jerboa)
    warn("Nyala:", Counts.Nyala)
    warn("TOTAL:", Total)
    warn("================================")


    --====================================================
    -- 300 OR MORE
    --====================================================

    if Total >= 300 then

        SetStatus(
            "TRADE WORLD",
            Total .. " / 300",
            "KICK - 300 REACHED"
        )

        warn("TARGET PET TOTAL >= 300")
        warn("KICK PLAYER")

        task.wait(1)

        LocalPlayer:Kick(
            "Springbee + Jerboa + Nyala reached 300."
        )

        return
    end


    --====================================================
    -- BELOW 300
    --====================================================

    SetStatus(
        "TRADE WORLD",
        Total .. " / 300",
        "BUYTRASH"
    )


    if not BuyTrashStarted then

        BuyTrashStarted = true

        warn("TARGET PET TOTAL < 300")
        warn("START BUYTRASH")

        task.spawn(function()

            ExecuteScript(
                BUYTRASH_URL
            )

        end)

    end
end


