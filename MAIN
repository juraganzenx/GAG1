local function Execute(url)
    task.spawn(function()
        local ok, err = pcall(function()
            loadstring(game:HttpGet(url, true))()
        end)

        if not ok then
            warn(err)
        end
    end)
end

Execute("https://raw.githubusercontent.com/juraganzenx/GAG1/refs/heads/main/AUTOHATCH")
Execute("https://raw.githubusercontent.com/juraganzenx/GAG1/refs/heads/main/DESTROYPLOT")
Execute("https://raw.githubusercontent.com/juraganzenx/GAG1/refs/heads/main/ANTIAFK")
Execute("https://raw.githubusercontent.com/juraganzenx/GAG1/refs/heads/main/WRITEJOBID")
